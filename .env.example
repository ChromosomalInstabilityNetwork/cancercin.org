# Copy to .env for local use. Variables prefixed PUBLIC_ are embedded in the built site.

# Where the site is served. Leave unset for local development.
# Project page:  SITE_URL=https://<user>.github.io  BASE_PATH=/<repo>
# Custom domain: SITE_URL=https://cancercin.org     (no BASE_PATH)
SITE_URL=
BASE_PATH=

# Optional: use a different map style (MapLibre style JSON). "{key}" is replaced by PUBLIC_MAP_KEY.
# The key is public by design; restrict it to your domain with the tile provider.
PUBLIC_MAP_STYLE_URL=
PUBLIC_MAP_KEY=

# Only for `npm run geocode` (never committed, never used by the site):
# a contact email for Nominatim's User-Agent, as its usage policy requires.
GEOCODE_CONTACT=
