---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import PeopleMap from '../../components/PeopleMap.astro';
import PersonAvatar from '../../components/PersonAvatar.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { mailto, CONTACT_EMAIL } from '../../lib/site';

const people = (await getCollection('people')).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, undefined, { numeric: true }),
);
const addBody = 'Name:\nInstitution:\nAddress:\n';
---

<BaseLayout
	title="People"
	description="The laboratories and investigators of the International CIN Network."
>
	<div class="people" data-map="shown" data-people-root>
		<div class="left" data-scroll>
			<div class="left-inner">
				<h1>People</h1>
				<Card class="add" title="Would you like to be added?" headingLevel="h2">
					<p>
						Email your name, institution, and address to{' '}
						<a href={mailto('Add me to the CIN people directory', addBody)}>{CONTACT_EMAIL}</a>.
					</p>
				</Card>
				<div class="controls">
					<div class="search">
						<label for="people-search" class="visually-hidden">
							Search people
						</label>
						<input
							id="people-search"
							type="search"
							placeholder="Search people"
							autocomplete="off"
							spellcheck="false"
						/>
					</div>
					<button
						type="button"
						class="map-toggle"
						id="map-toggle"
						aria-controls="people-map-pane"
						aria-expanded="true"
						hidden
					>
						<svg
							viewBox="0 0 24 24"
							aria-hidden="true"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M9 4 3 6.5v13L9 17l6 3 6-2.5v-13L15 7 9 4Zm0 0v13m6-10v13" />
						</svg>
						<span data-label>Hide map</span>
					</button>
				</div>
				<p class="visually-hidden" id="people-count" aria-live="polite"></p>
				<p class="none" id="people-none" hidden>
					No one matches your search.
				</p>
				<ul class="directory" aria-label="Directory" data-directory>
					{people.map((p) => (
						<li class="person" id={p.id}>
							<div class="row">
								<span class="pic">
									<PersonAvatar name={p.data.name} photo={p.data.photo} />
								</span>
								<span class="text">
									<span class="name">
										{p.data.website ? (
											<a
												class="name-link"
												href={p.data.website}
												target="_blank"
												rel="noopener noreferrer"
											>
												{p.data.name}
											</a>
										) : (
											p.data.name
										)}
									</span>
									{p.data.institution && <span class="inst">{p.data.institution}</span>}
									{p.data.address && <span class="addr">{p.data.address}</span>}
								</span>
							</div>
							<div class="links">
								<SocialLinks
									name={p.data.name}
									website={p.data.website}
									bluesky={p.data.bluesky}
									x={p.data.x}
									linkedin={p.data.linkedin}
								/>
							</div>
							<button
								type="button"
								class="select"
								data-person-id={p.id}
								aria-pressed="false"
								aria-label={`${p.data.name}: show on map`}
							></button>
						</li>
					))}
				</ul>
			</div>
		</div>
		<div class="map" id="people-map-pane">
			<PeopleMap />
		</div>
	</div>
</BaseLayout>

<script>
	const root = document.querySelector<HTMLElement>('[data-people-root]')!;
	const input = document.querySelector<HTMLInputElement>('#people-search')!;
	const toggle = document.querySelector<HTMLButtonElement>('#map-toggle')!;
	const pane = document.querySelector<HTMLElement>('#people-map-pane')!;
	const count = document.querySelector<HTMLElement>('#people-count')!;
	const none = document.querySelector<HTMLElement>('#people-none')!;
	const items = Array.from(document.querySelectorAll<HTMLLIElement>('.directory > li'));
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
	const fold = (t: string) =>
		t
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase();
	const haystack = new Map(
		items.map((li) => [li, fold(li.querySelector('.text')?.textContent ?? '')]),
	);

	/** FLIP: remember where the visible rows are, change the layout, then glide each row to its new spot. */
	function flip(change: () => void) {
		const moving = items.filter((li) => !li.hidden);
		const first = new Map(moving.map((li) => [li, li.getBoundingClientRect()]));
		change();
		if (reduce.matches) return;
		for (const li of moving) {
			if (li.hidden) continue;
			const a = first.get(li)!;
			const b = li.getBoundingClientRect();
			const dx = a.left - b.left;
			const dy = a.top - b.top;
			if (!dx && !dy) continue;
			li.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], {
				duration: 420,
				easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
			});
		}
	}

	function applyFilter() {
		const terms = fold(input.value).split(/\s+/).filter(Boolean);
		let shown = 0;
		const ids: string[] = [];
		flip(() => {
			for (const li of items) {
				const hay = haystack.get(li)!;
				const ok = terms.every((t) => hay.includes(t));
				li.hidden = !ok;
				if (ok) {
					shown++;
					ids.push(li.id);
				}
			}
		});
		none.hidden = shown > 0;
		count.textContent = terms.length ? `${shown} of ${items.length} people` : '';
		window.dispatchEvent(
			new CustomEvent('people:filter', { detail: { ids: terms.length ? ids : null } }),
		);
	}
	input.addEventListener('input', applyFilter);

	// Hide / show the map. Hidden, the directory becomes a multi-column list.
	toggle.hidden = false;
	toggle.addEventListener('click', async () => {
		const hiding = root.dataset.map !== 'hidden';
		const label = toggle.querySelector('[data-label]')!;
		toggle.setAttribute('aria-expanded', String(!hiding));
		label.textContent = hiding ? 'Show map' : 'Hide map';
		if (hiding) {
			if (!reduce.matches) {
				pane.style.opacity = '0';
				await new Promise((r) => setTimeout(r, 180));
			}
			flip(() => (root.dataset.map = 'hidden'));
		} else {
			pane.style.opacity = '0';
			flip(() => (root.dataset.map = 'shown'));
			window.dispatchEvent(new Event('people:mapshown'));
			requestAnimationFrame(() => (pane.style.opacity = '1'));
		}
	});
</script>

<style>
	/* One viewport tall below the 72px nav. The whole left column scrolls; the map is fixed and runs
	   edge to edge, from the nav to the footer and out to the right edge of the page. */
	.people {
		display: grid;
		grid-template-columns: minmax(380px, 1fr) 2fr;
		height: calc(100dvh - 72px);
		min-height: 520px;
	}
	.left {
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
	}
	.left-inner {
		display: flex;
		flex-direction: column;
		gap: 16px;
		/* Align with the site container on the left. */
		padding: 24px 24px 32px max(var(--pad-x), calc((100% - var(--max-width)) / 2));
	}
	h1 {
		margin: 0;
		font-size: var(--fs-h1);
	}
	.left :global(.add) {
		max-width: 560px;
		padding: 14px 18px;
	}
	.left :global(.add h2) {
		font-size: 1rem;
		margin-bottom: 4px;
	}
	.left :global(.add p) {
		font-size: 0.9375rem;
		margin-bottom: 0;
	}
	.map {
		min-height: 0;
		transition: opacity 0.18s;
	}
	.controls {
		display: flex;
		gap: 10px;
		align-items: center;
		max-width: 520px;
	}
	.search {
		flex: 1;
	}
	.search input {
		width: 100%;
		min-height: 44px;
		padding: 0 14px;
		font: inherit;
		color: var(--ink);
		background: #fff;
		border: 1px solid #b9b5c4;
		border-radius: 999px;
	}
	.map-toggle {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 16px;
		font: inherit;
		font-weight: 600;
		color: var(--accent);
		background: none;
		border: 2px solid var(--accent);
		border-radius: 999px;
		cursor: pointer;
		white-space: nowrap;
	}
	.map-toggle[hidden] {
		display: none;
	}
	.map-toggle svg {
		width: 18px;
		height: 18px;
	}
	.none {
		margin: 0;
		color: var(--muted);
	}
	.none[hidden],
	.person[hidden] {
		display: none;
	}

	/* Map hidden: the left column takes the full width and the directory flows into columns. */
	[data-map='hidden'] {
		grid-template-columns: 1fr;
	}
	[data-map='hidden'] .map {
		display: none;
	}
	[data-map='hidden'] .left-inner {
		padding-right: max(var(--pad-x), calc((100% - var(--max-width)) / 2));
	}
	[data-map='hidden'] .directory {
		columns: 300px;
		column-gap: 32px;
	}
	[data-map='hidden'] .person {
		break-inside: avoid;
	}
	.directory {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.person {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 8px 6px;
		border-left: 3px solid transparent;
	}
	.person:has(.select[aria-pressed='true']) {
		border-left-color: var(--accent);
		background: #f8f4f8;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 14px;
		min-height: 44px;
	}
	/* The whole row selects the person on the map; the name and link icons sit above it. */
	.select {
		position: absolute;
		inset: 0;
		z-index: 1;
		padding: 0;
		background: none;
		border: 0;
		cursor: pointer;
	}
	.name-link,
	.links {
		position: relative;
		z-index: 2;
	}
	.name-link {
		color: inherit;
		text-decoration: none;
	}
	.name-link:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.pic {
		flex: none;
		width: 48px;
		height: 48px;
	}
	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.3;
	}
	.name {
		font-family: var(--font-display);
		font-size: 1.0625rem;
		font-weight: 600;
	}
	.person:has(.select[aria-pressed='true']) .name {
		color: var(--accent);
	}
	.inst {
		font-size: 14px;
		font-weight: 500;
	}
	.addr {
		font-size: 13px;
		color: var(--muted);
	}
	.links {
		padding-left: 62px;
		min-height: 4px;
	}
	@media (max-width: 900px) {
		/* Map on top and sticky; the page itself scrolls the list underneath it. */
		.people {
			display: flex;
			flex-direction: column;
			height: auto;
		}
		.map {
			order: -1;
			position: sticky;
			top: 72px;
			z-index: 5;
			height: 30dvh;
			min-height: 200px;
		}
		.left {
			overflow: visible;
		}
		.left-inner {
			padding: 16px var(--pad-x) 32px;
		}
		.pic {
			width: 40px;
			height: 40px;
		}
		.links {
			padding-left: 54px;
		}
	}
</style>
