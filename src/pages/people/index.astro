---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import PeopleMap from '../../components/PeopleMap.astro';
import PersonAvatar from '../../components/PersonAvatar.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { mailto, CONTACT_EMAIL } from '../../lib/site';

const people = (await getCollection('people')).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, undefined, { numeric: true }),
);
const addBody = 'Name:\nInstitution:\nAddress:\n';
---

<BaseLayout
	title="People"
	description="The laboratories and investigators of the International CIN Network."
>
	<div class="people">
		<div class="left" data-scroll>
			<div class="left-inner">
				<h1>People</h1>
				<Card class="add" title="Would you like to be added?" headingLevel="h2">
					<p>
						Email your name, institution, and address to{' '}
						<a href={mailto('Add me to the CIN people directory', addBody)}>{CONTACT_EMAIL}</a>.
					</p>
				</Card>
				<ul class="directory" aria-label="Directory" data-directory>
					{people.map((p) => (
						<li class="person" id={p.id}>
							<button type="button" class="select" data-person-id={p.id} aria-pressed="false">
								<span class="pic">
									<PersonAvatar name={p.data.name} photo={p.data.photo} />
								</span>
								<span class="text">
									<span class="name">{p.data.name}</span>
									{p.data.institution && <span class="inst">{p.data.institution}</span>}
									{p.data.address && <span class="addr">{p.data.address}</span>}
								</span>
							</button>
							<div class="links">
								<SocialLinks
									name={p.data.name}
									website={p.data.website}
									bluesky={p.data.bluesky}
									x={p.data.x}
									linkedin={p.data.linkedin}
								/>
							</div>
						</li>
					))}
				</ul>
			</div>
		</div>
		<div class="map">
			<PeopleMap />
		</div>
	</div>
</BaseLayout>

<style>
	/* One viewport tall below the 72px nav. The whole left column scrolls; the map is fixed and runs
	   edge to edge, from the nav to the footer and out to the right edge of the page. */
	.people {
		display: grid;
		grid-template-columns: minmax(380px, 1fr) 2fr;
		height: calc(100dvh - 72px);
		min-height: 520px;
	}
	.left {
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
	}
	.left-inner {
		display: flex;
		flex-direction: column;
		gap: 16px;
		/* Align with the site container on the left. */
		padding: 24px 24px 32px max(var(--pad-x), calc((100% - var(--max-width)) / 2));
	}
	h1 {
		margin: 0;
		font-size: var(--fs-h1);
	}
	.left :global(.add) {
		padding: 14px 18px;
	}
	.left :global(.add h2) {
		font-size: 1rem;
		margin-bottom: 4px;
	}
	.left :global(.add p) {
		font-size: 0.9375rem;
		margin-bottom: 0;
	}
	.map {
		min-height: 0;
	}
	.directory {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.person {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 8px 6px;
		border-left: 3px solid transparent;
	}
	.person:has(.select[aria-pressed='true']) {
		border-left-color: var(--accent);
		background: #f8f4f8;
	}
	.select {
		display: flex;
		align-items: center;
		gap: 14px;
		width: 100%;
		min-height: 44px;
		padding: 0;
		text-align: left;
		font: inherit;
		color: var(--ink);
		background: none;
		border: 0;
		cursor: pointer;
	}
	.pic {
		flex: none;
		width: 48px;
		height: 48px;
	}
	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.3;
	}
	.name {
		font-family: var(--font-display);
		font-size: 1.0625rem;
		font-weight: 600;
	}
	.select[aria-pressed='true'] .name {
		color: var(--accent);
	}
	.inst {
		font-size: 14px;
		font-weight: 500;
	}
	.addr {
		font-size: 13px;
		color: var(--muted);
	}
	.links {
		padding-left: 62px;
		min-height: 4px;
	}
	@media (max-width: 900px) {
		/* Map on top and sticky; the page itself scrolls the list underneath it. */
		.people {
			display: flex;
			flex-direction: column;
			height: auto;
		}
		.map {
			order: -1;
			position: sticky;
			top: 72px;
			z-index: 5;
			height: 30dvh;
			min-height: 200px;
		}
		.left {
			overflow: visible;
		}
		.left-inner {
			padding: 16px var(--pad-x) 32px;
		}
		.pic {
			width: 40px;
			height: 40px;
		}
		.links {
			padding-left: 54px;
		}
	}
</style>
