---
import { getPublished } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinForm from '../../components/JoinForm.astro';
import PeopleMap from '../../components/PeopleMap.astro';
import PersonAvatar from '../../components/PersonAvatar.astro';
import SocialLinks from '../../components/SocialLinks.astro';

const people = (await getPublished('people')).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, undefined, { numeric: true }),
);
const roles = [...new Set(people.flatMap((p) => p.data.role ?? []))].sort();
---

<BaseLayout
	title="People"
	description="The laboratories and investigators of the International CIN Network."
>
	<div class="people" data-map="shown" data-people-root>
		<button
			type="button"
			class="map-toggle"
			id="map-toggle"
			aria-controls="people-map-pane"
			aria-expanded="true"
			aria-label="Hide map"
			title="Hide map"
			hidden
		>
			<svg
				viewBox="0 0 24 24"
				aria-hidden="true"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M9 4 3 6.5v13L9 17l6 3 6-2.5v-13L15 7 9 4Zm0 0v13m6-10v13" />
			</svg>
		</button>
		<div class="left" data-scroll>
			<div class="left-inner">
				<h1>People</h1>
				<div class="controls">
					<div class="search">
						<label for="people-search" class="visually-hidden">
							Search people
						</label>
						<input
							id="people-search"
							class="control"
							type="search"
							placeholder="Search people"
							autocomplete="off"
							spellcheck="false"
						/>
					</div>
					{roles.length > 1 && (
						<div class="role-filter">
							<label for="people-role" class="visually-hidden">
								Filter by role
							</label>
							<select id="people-role" class="control">
								<option value="">All Members</option>
								{roles.map((r) => (
									<option value={r}>{r}</option>
								))}
							</select>
						</div>
					)}
				</div>
				<JoinForm />
				<p class="visually-hidden" id="people-count" aria-live="polite"></p>
				<p class="none" id="people-none" hidden>
					No one matches your search.
				</p>
				<ul class="directory" aria-label="Directory" data-directory>
					{people.map((p) => (
						<li class="person" id={p.id} data-role={p.data.role}>
							<div class="row">
								<span class="pic">
									<PersonAvatar name={p.data.name} photo={p.data.photo} />
								</span>
								<span class="text">
									<span class="name">
										{p.data.website ? (
											<a
												class="name-link"
												href={p.data.website}
												target="_blank"
												rel="noopener noreferrer"
											>
												{p.data.name}
											</a>
										) : (
											p.data.name
										)}
									</span>
									{p.data.role && <span class="role">{p.data.role}</span>}
									{p.data.institution && <span class="inst">{p.data.institution}</span>}
									{p.data.location && <span class="addr">{p.data.location}</span>}
								</span>
							</div>
							<div class="links">
								<SocialLinks
									name={p.data.name}
									website={p.data.website}
									bluesky={p.data.bluesky}
									x={p.data.x}
									linkedin={p.data.linkedin}
								/>
							</div>
							<button
								type="button"
								class="select"
								data-person-id={p.id}
								aria-pressed="false"
								aria-label={`${p.data.name}: show on map`}
							></button>
						</li>
					))}
				</ul>
			</div>
		</div>
		<div class="map" id="people-map-pane">
			<PeopleMap />
		</div>
	</div>
</BaseLayout>

<script>
	const root = document.querySelector<HTMLElement>('[data-people-root]')!;
	const input = document.querySelector<HTMLInputElement>('#people-search')!;
	const role = document.querySelector<HTMLSelectElement>('#people-role');
	const toggle = document.querySelector<HTMLButtonElement>('#map-toggle')!;
	const pane = document.querySelector<HTMLElement>('#people-map-pane')!;
	const count = document.querySelector<HTMLElement>('#people-count')!;
	const none = document.querySelector<HTMLElement>('#people-none')!;
	const items = Array.from(document.querySelectorAll<HTMLLIElement>('.directory > li'));
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
	const fold = (t: string) =>
		t
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase();
	const haystack = new Map(
		items.map((li) => [li, fold(li.querySelector('.text')?.textContent ?? '')]),
	);

	/** FLIP: remember where the visible rows are, change the layout, then glide each row to its new spot. */
	function flip(change: () => void) {
		const moving = items.filter((li) => !li.hidden);
		const first = new Map(moving.map((li) => [li, li.getBoundingClientRect()]));
		change();
		if (reduce.matches) return;
		for (const li of moving) {
			if (li.hidden) continue;
			const a = first.get(li)!;
			const b = li.getBoundingClientRect();
			const dx = a.left - b.left;
			const dy = a.top - b.top;
			if (!dx && !dy) continue;
			li.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], {
				duration: 420,
				easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
			});
		}
	}

	// Everyone is in the page, but only the first PAGE matches are shown; more are revealed on scroll.
	const PAGE = 40;
	let limit = PAGE;
	const matched = new Map<HTMLLIElement, number>(); // position of each match, counting from 1

	function applyFilter(resetLimit = true) {
		if (resetLimit) limit = PAGE;
		const terms = fold(input.value).split(/\s+/).filter(Boolean);
		const ids: string[] = [];
		matched.clear();
		flip(() => {
			for (const li of items) {
				const hay = haystack.get(li)!;
				const ok =
					terms.every((t) => hay.includes(t)) && (!role?.value || li.dataset.role === role.value);
				if (ok) {
					matched.set(li, matched.size + 1);
					ids.push(li.id);
				}
				li.hidden = !ok || matched.size > limit;
			}
		});
		none.hidden = matched.size > 0;
		more.hidden = matched.size <= limit;
		const filtered = terms.length > 0 || !!role?.value;
		count.textContent = filtered ? `${matched.size} of ${items.length} people` : '';
		// The map shows every match, including those not revealed in the list yet.
		window.dispatchEvent(
			new CustomEvent('people:filter', { detail: { ids: filtered ? ids : null } }),
		);
	}
	input.addEventListener('input', () => applyFilter());
	role?.addEventListener('change', () => applyFilter());

	// An invisible marker under the list: scrolling it into view shows the next page.
	const more = document.createElement('div');
	more.style.height = '1px';
	more.setAttribute('aria-hidden', 'true');
	document.querySelector('[data-directory]')!.after(more);
	new IntersectionObserver(
		(entries) => {
			if (entries.some((e) => e.isIntersecting) && matched.size > limit) {
				limit += PAGE;
				applyFilter(false);
			}
		},
		{ rootMargin: '600px' },
	).observe(more);

	/** Show the list far enough to include this person (selected on the map, or linked to by #id). */
	function reveal(id: string) {
		const position = matched.get(document.getElementById(id) as HTMLLIElement) ?? 0;
		if (position <= limit) return;
		limit = Math.ceil(position / PAGE) * PAGE;
		applyFilter(false);
	}
	window.addEventListener('people:reveal', (e) =>
		reveal((e as CustomEvent<{ id: string }>).detail.id),
	);
	applyFilter();
	reveal(decodeURIComponent(location.hash.slice(1)));

	// Hide / show the map. Hidden, the directory becomes a multi-column list.
	toggle.hidden = false;
	toggle.addEventListener('click', async () => {
		const hiding = root.dataset.map !== 'hidden';
		toggle.setAttribute('aria-expanded', String(!hiding));
		const text = hiding ? 'Show map' : 'Hide map';
		toggle.setAttribute('aria-label', text);
		toggle.title = text;
		if (hiding) {
			if (!reduce.matches) {
				pane.style.opacity = '0';
				await new Promise((r) => setTimeout(r, 180));
			}
			flip(() => (root.dataset.map = 'hidden'));
		} else {
			pane.style.opacity = '0';
			flip(() => (root.dataset.map = 'shown'));
			window.dispatchEvent(new Event('people:mapshown'));
			requestAnimationFrame(() => (pane.style.opacity = '1'));
		}
	});
</script>

<style>
	/* One viewport tall below the top bar. The whole left column scrolls; the map is fixed and runs
	   edge to edge, from the nav to the footer and out to the right edge of the page. */
	.people {
		display: grid;
		grid-template-columns: minmax(380px, 1fr) 2fr;
		height: calc(100vh - var(--nav-h)); /* fallback for browsers without dvh */
		height: calc(100dvh - var(--nav-h));
		min-height: 520px;
		/* Align with the site container. Set here (not on the column) so it never changes when the
		   column is resized by showing or hiding the map. */
		padding-left: var(--gutter);
	}
	.left {
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
	}
	.left-inner {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 24px 24px 32px 0;
	}
	h1 {
		margin: 0;
		font-size: var(--fs-h1);
	}
	.map {
		min-height: 0;
		transition: opacity 0.18s;
	}
	.controls {
		display: flex;
		gap: 10px;
		align-items: center;
		max-width: 520px;
	}
	.search {
		flex: 1;
	}
	.search input {
		width: 100%;
	}
	/* Pinned to the bottom-right corner of the viewport, so it stays put while scrolling. */
	.map-toggle {
		position: fixed;
		right: 16px;
		bottom: 44px; /* clears the map attribution */
		z-index: 40;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		color: var(--ink);
		background: #fff;
		border: 1px solid #b9b5c4;
		border-radius: 50%;
		box-shadow: 0 1px 4px rgba(27, 26, 46, 0.25);
		cursor: pointer;
	}
	.map-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.map-toggle[hidden] {
		display: none;
	}
	.map-toggle svg {
		width: 22px;
		height: 22px;
	}
	.none {
		margin: 0;
		color: var(--muted);
	}
	.none[hidden],
	.person[hidden] {
		display: none;
	}

	/* Map hidden: the left column takes the full width and the directory flows into columns. */
	[data-map='hidden'] {
		grid-template-columns: 1fr;
	}
	[data-map='hidden'] .map {
		display: none;
	}
	/* No map: the list is just page content, so only the page scrolls (one scrollbar, not two). */
	[data-map='hidden'] {
		height: auto;
	}
	[data-map='hidden'] .left {
		overflow: visible;
	}
	[data-map='hidden'] {
		padding-right: var(--gutter);
	}
	[data-map='hidden'] .left-inner {
		padding-right: 0;
	}
	[data-map='hidden'] .directory {
		columns: 300px;
		column-gap: 32px;
	}
	[data-map='hidden'] .person {
		break-inside: avoid;
	}
	.directory {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.person {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 8px 6px;
		border-left: 3px solid transparent;
	}
	.person:has(.select[aria-pressed='true']) {
		border-left-color: var(--accent);
		background: #f8f4f8;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 14px;
		min-height: 44px;
	}
	/* The whole row selects the person on the map; the name and link icons sit above it. */
	.select {
		position: absolute;
		inset: 0;
		z-index: 1;
		padding: 0;
		background: none;
		border: 0;
		cursor: pointer;
	}
	.name-link,
	.links {
		position: relative;
		z-index: 2;
	}
	.name-link {
		color: inherit;
		text-decoration: none;
	}
	.name-link:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.pic {
		flex: none;
		width: 48px;
		height: 48px;
	}
	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.3;
	}
	.name {
		font-family: var(--font-display);
		font-size: 1.0625rem;
		font-weight: 600;
	}
	.person:has(.select[aria-pressed='true']) .name {
		color: var(--accent);
	}
	.inst {
		font-size: 0.875rem;
		font-weight: 500;
	}
	.role,
	.addr {
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.links {
		padding-left: 62px;
		min-height: 4px;
	}
	@media (max-width: 900px) {
		/* Map on top and sticky; the page itself scrolls the list underneath it. */
		.people {
			display: flex;
			flex-direction: column;
			height: auto;
			padding-inline: 0;
		}
		.map {
			order: -1;
			position: sticky;
			top: var(--nav-h);
			z-index: 5;
			height: 30vh;
			height: 30dvh;
			min-height: 200px;
		}
		.left {
			overflow: visible;
		}
		.left-inner {
			padding: 16px var(--pad-x) 32px;
		}
		.pic {
			width: 40px;
			height: 40px;
		}
		.links {
			padding-left: 54px;
		}
	}
</style>
