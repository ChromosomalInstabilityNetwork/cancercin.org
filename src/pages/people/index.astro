---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import PeopleMap from '../../components/PeopleMap.astro';
import PillButton from '../../components/PillButton.astro';
import { url } from '../../lib/url';
import { mailto, CONTACT_EMAIL } from '../../lib/site';

const people = (await getCollection('people')).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, undefined, { numeric: true }),
);
const addBody = 'Name:\nInstitution:\nAddress:\n';
---

<BaseLayout title="People" description="The laboratories and investigators of the Cancer CIN Consortium.">
	<PageHeader title="People" />

	<section class="section container">
		<div class="dir-map">
			<ul class="directory" aria-label="Directory" data-directory>
				{
					people.map((p) => (
						<li>
							<button type="button" class="person" data-person-id={p.id} aria-pressed="false">
								{p.data.photo ? (
									<img class="avatar" src={url(p.data.photo)} alt="" width="64" height="64" loading="lazy" />
								) : (
									<span class="avatar placeholder" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="currentColor">
											<circle cx="12" cy="8.5" r="4" />
											<path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5z" />
										</svg>
									</span>
								)}
								<span class="text">
									<span class="name">{p.data.name}</span>
									<span class="inst">{p.data.institution}</span>
									<span class="addr">{p.data.address}</span>
								</span>
							</button>
						</li>
					))
				}
			</ul>
			<div class="map">
				<PeopleMap />
			</div>
		</div>
	</section>

	<section class="container pair">
		<div class="grid grid-2">
			<Card variant="feature">
				<h3>Would you like to be added?</h3>
				<p>
					If you would like to be added to the directory, email your name, institution, and
					address to <a href={mailto('Add me to the CIN people directory', addBody)}>{CONTACT_EMAIL}</a>.
				</p>
				<PillButton href={mailto('Add me to the CIN people directory', addBody)}>
					Email us to be added
				</PillButton>
			</Card>
		</div>
	</section>
</BaseLayout>

<style>
	.dir-map {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: 32px;
		height: 520px;
		margin-top: 32px;
	}
	.directory {
		list-style: none;
		margin: 0;
		padding: 0 8px 0 0;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.person {
		width: 100%;
		text-align: left;
		display: flex;
		align-items: center;
		gap: 16px;
		min-height: 44px;
		padding: 16px 20px;
		background: #f8f8fa;
		border: 2px solid var(--border);
		border-radius: var(--radius-card);
		font: inherit;
		color: var(--ink);
		cursor: pointer;
	}
	.person[aria-pressed='true'] {
		background: #fff;
		border-color: var(--accent);
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.avatar {
		flex: none;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		object-fit: cover;
	}
	.avatar.placeholder {
		display: grid;
		place-items: end center;
		overflow: hidden;
		background: #e8e6ee;
		color: #aaa7bd;
	}
	.avatar.placeholder svg {
		width: 80%;
		height: 80%;
	}
	.name {
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 600;
	}
	.inst {
		font-size: 15px;
		font-weight: 500;
	}
	.addr {
		font-size: 14px;
		color: var(--muted);
	}
	.map {
		min-height: 0;
	}
	.pair {
		padding-bottom: var(--section-y);
	}
	@media (max-width: 900px) {
		/* Map on top (~30% of the screen), compact directory below (~60%). */
		.dir-map {
			grid-template-columns: 1fr;
			grid-template-rows: auto auto;
			gap: 16px;
			height: auto;
			margin-top: 16px;
		}
		.map {
			order: -1;
			height: 30dvh;
			min-height: 200px;
		}
		.directory {
			height: 60dvh;
			min-height: 240px;
			gap: 8px;
		}
		.person {
			gap: 12px;
			padding: 8px 12px;
			border-radius: 12px;
		}
		.text {
			gap: 0;
			line-height: 1.25;
		}
		.avatar {
			width: 40px;
			height: 40px;
		}
		.name {
			font-size: 1rem;
		}
		.inst {
			font-size: 13px;
		}
		.addr {
			font-size: 12px;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
	}
</style>
