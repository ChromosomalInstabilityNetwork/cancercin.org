---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillButton from '../components/PillButton.astro';
import { url } from '../lib/url';
---

<BaseLayout>
	<section class="hero on-dark">
		<div class="container">
			<h1>
				Chromosomal instability: cancer's oldest hallmark, and one of its biggest opportunities.
			</h1>
			<p class="lead">
				CIN drives cancer formation and therapy resistance, but it also offers a chance to
				transform how we treat and prevent cancer. We're uniting cell biology, genomics, and the
				clinic to turn that potential into patient benefit.
			</p>
			<div class="actions">
				<PillButton href={url('about/challenges-and-roadmap/')} variant="light">
					Explore the challenges
				</PillButton>
				<PillButton href={url('events/')} variant="ghost">See upcoming events</PillButton>
			</div>
		</div>
	</section>

</BaseLayout>

<style>
	.hero {
		background: var(--ink);
		color: var(--on-dark);
		padding-block: clamp(32px, 5vw, 56px);
	}
	.hero h1 {
		color: var(--on-dark-strong);
		max-width: 940px;
		font-size: clamp(2rem, 1.6rem + 1.6vw, 3.25rem);
	}
	.lead {
		font-size: 1.125rem;
		max-width: 720px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 24px;
	}
	@media (max-width: 900px) {
	</style>
