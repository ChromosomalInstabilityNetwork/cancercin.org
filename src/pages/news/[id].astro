---
import { render } from 'astro:content';
import { getPublished } from '../../lib/content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import PillButton from '../../components/PillButton.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
	const news = await getPublished('news');
	return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, summary, link, image, image_alt } = entry.data;
const when = date
	? new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(date)
	: '[Date]';
---

<SectionLayout title={title} description={summary}>
	<article class="post">
		{image && <img class="hero" src={url(image)} alt={image_alt} loading="lazy" />}
		<p class="date">
			{date ? <time datetime={date.toISOString().slice(0, 10)}>{when}</time> : when}
		</p>
		<p class="summary">{summary}</p>
		<Content />
		{link && (
			<p>
				<PillButton href={link} external>
					Read more
				</PillButton>
			</p>
		)}
		<p>
			<a href={url('news/')}>← All news and views</a>
		</p>
	</article>
</SectionLayout>

<style>
	.post {
		max-width: 720px;
	}
	.hero {
		width: 100%;
		max-height: 360px;
		object-fit: cover;
		border-radius: var(--radius-card);
		margin-bottom: 20px;
	}
	.date {
		margin: 0 0 8px;
		color: var(--muted);
	}
	/* Same typeface and size as the date above it. */
	.summary {
		font-family: inherit;
		font-size: inherit;
	}
</style>
