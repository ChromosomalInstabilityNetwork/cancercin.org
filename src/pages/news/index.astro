---
import SectionLayout from '../../layouts/SectionLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNews, formatPostDate } from '../../lib/events';
import { url } from '../../lib/url';

const [latest, ...rest] = await getNews();
---

<SectionLayout
	title="News and Views"
	description="News and views from the International CIN Network community."
>
	{latest && (
		<article class="feature">
			{latest.data.image && (
				<img
					class="feature-img"
					src={url(latest.data.image)}
					alt={latest.data.image_alt}
					width="960"
					height="540"
				/>
			)}
			<div class="feature-body">
				<p class="date">
					{latest.data.date ? (
						<time datetime={latest.data.date.toISOString().slice(0, 10)}>
							{formatPostDate(latest.data.date)}
						</time>
					) : (
						formatPostDate(latest.data.date)
					)}
				</p>
				<h2>
					<a href={url(`news/${latest.id}/`)}>{latest.data.title}</a>
				</h2>
				<p class="summary">{latest.data.summary}</p>
				<p class="read">
					<a href={url(`news/${latest.id}/`)}>
						Read more<span class="visually-hidden">: {latest.data.title}</span> →
					</a>
				</p>
			</div>
		</article>
	)}

	{rest.length > 0 && (
		<div class="grid-3">
			{rest.map((n) => (
				<NewsCard
					stacked
					title={n.data.title}
					date={n.data.date}
					summary={n.data.summary}
					headingLevel="h3"
					link={url(`news/${n.id}/`)}
					image={n.data.image}
					imageAlt={n.data.image_alt}
				/>
			))}
		</div>
	)}
</SectionLayout>

<style>
	.feature {
		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
		background: var(--ink);
		color: var(--on-dark);
		border-radius: var(--radius-feature);
		margin-bottom: 32px;
	}
	.feature:has(.feature-img) {
		grid-template-columns: 1.1fr 1fr;
	}
	.feature-img {
		width: 100%;
		height: 100%;
		min-height: 260px;
		object-fit: cover;
	}
	.feature-body {
		align-self: center;
		padding: clamp(24px, 4vw, 48px);
	}
	.date {
		margin: 0 0 10px;
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--pink);
	}
	.feature h2 {
		margin: 0 0 12px;
		font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
		color: var(--on-dark-strong);
	}
	.feature h2 a {
		color: inherit;
		text-decoration: none;
	}
	.feature h2 a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.summary {
		margin: 0 0 20px;
		font-size: 1.0625rem;
		max-width: 60ch;
	}
	.read {
		margin: 0;
		font-weight: 600;
	}
	.read a {
		color: var(--pink);
	}
	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}
	/* 900px is where the side menu disappears and the content goes full width. */
	@media (max-width: 900px) {
		.feature:has(.feature-img) {
			grid-template-columns: 1fr;
		}
		.grid-3 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 700px) {
		.grid-3 {
			grid-template-columns: 1fr;
		}
	}
</style>
