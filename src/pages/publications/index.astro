---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const all = await getCollection('publications');

// Normalise to a sortable "YYYY-MM-DD" (missing parts become 00) and a display label.
const parts = (p: (typeof all)[number]) => {
	const d = p.data.date ?? (p.data.year ? String(p.data.year) : '');
	const [y = '', m = '00', day = '00'] = d.split('-');
	return { y, m, day, key: `${y}-${m}-${day}` };
};
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dateLabel = (p: (typeof all)[number]) => {
	const { y, m, day } = parts(p);
	if (!y) return '[Date]';
	if (m === '00') return y;
	return day === '00' ? `${MONTHS[+m - 1]} ${y}` : `${+day} ${MONTHS[+m - 1]} ${y}`;
};

const rows = all
	.filter((p) => !p.data.featured)
	.sort(
		(a, b) => parts(b).key.localeCompare(parts(a).key) || a.data.title.localeCompare(b.data.title),
	);

const years = [...new Set(rows.map((p) => parts(p).y).filter(Boolean))].sort().reverse();
---

<BaseLayout
	title="Publications"
	description="Recent publications on chromosomal instability, updated automatically from PubMed."
>
	<PageHeader title="Publications" />

	<div class="container top">
		<div class="intro">
			<p>Recent publications on chromosomal instability, updated automatically from PubMed.</p>
		</div>
	</div>

	<section class="container library" aria-label="Publications">
		<form class="filters" data-filters hidden onsubmit="return false">
			<div class="field search">
				<label for="f-q">Search</label>
				<input
					id="f-q"
					type="search"
					placeholder="Title, author, journal, or keyword"
					autocomplete="off"
				/>
			</div>
			<div class="field">
				<label for="f-year">Year</label>
				<select id="f-year">
					<option value="">All years</option>
					{years.map((y) => (
						<option value={y}>{y}</option>
					))}
				</select>
			</div>
			<button type="reset" class="clear" data-clear>
				Clear
			</button>
		</form>
		<p class="count" aria-live="polite" data-count hidden></p>

		<div class="table-wrap">
			<table>
				<caption class="visually-hidden">Publications from the consortium</caption>
				<thead>
					<tr>
						<th scope="col">Date</th>
						<th scope="col">Title</th>
						<th scope="col">Authors</th>
						<th scope="col">Journal</th>
						<th scope="col">Keyword</th>
					</tr>
				</thead>
				<tbody>
					{rows.map((p) => (
						<tr
							data-year={parts(p).y}
							data-text={`${p.data.title} ${p.data.authors} ${p.data.journal} ${p.data.keywords.join(' ')}`.toLowerCase()}
						>
							<td data-label="Date" class="date">
								<time datetime={parts(p).y ? parts(p).key.replace(/-00/g, '') : undefined}>
									{dateLabel(p)}
								</time>
							</td>
							<td data-label="Title" class="title">
								{p.data.url ? <a href={p.data.url}>{p.data.title}</a> : p.data.title}
							</td>
							<td data-label="Authors">{p.data.authors}</td>
							<td data-label="Journal">{p.data.journal}</td>
							<td data-label="Keyword" class="kw">
								<div class="chips">
									{p.data.keywords.map((k) => (
										<span class="chip">{k}</span>
									))}
								</div>
							</td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="empty" data-empty hidden>
				No publications match these filters.
			</p>
		</div>
	</section>
</BaseLayout>

<script>
	// Filters are an enhancement: without JS the full table is shown.
	const form = document.querySelector<HTMLFormElement>('[data-filters]');
	if (form) {
		form.hidden = false;
		const q = form.querySelector<HTMLInputElement>('#f-q')!;
		const year = form.querySelector<HTMLSelectElement>('#f-year')!;
		const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('tbody tr'));
		const count = document.querySelector<HTMLElement>('[data-count]')!;
		const empty = document.querySelector<HTMLElement>('[data-empty]')!;
		count.hidden = false;

		// Rows are all in the page, but only the first PAGE are shown; more are revealed on scroll.
		const PAGE = 40;
		let limit = PAGE;
		let matches = 0;

		const apply = (resetLimit = true) => {
			if (resetLimit) limit = PAGE;
			const text = q.value.trim().toLowerCase();
			matches = 0;
			for (const r of rows) {
				const ok =
					(!text || r.dataset.text!.includes(text)) &&
					(!year.value || r.dataset.year === year.value);
				if (ok) matches++;
				r.hidden = !ok || matches > limit;
			}
			const shown = Math.min(matches, limit);
			count.textContent = `Showing ${shown} of ${matches} publication${matches === 1 ? '' : 's'}`;
			empty.hidden = matches > 0;
			more.hidden = matches <= limit;
		};

		// An invisible marker under the table: scrolling it into view loads the next page.
		const more = document.createElement('div');
		more.className = 'more';
		more.setAttribute('aria-hidden', 'true');
		more.hidden = true;
		empty.before(more);
		new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting) && matches > limit) {
					limit += PAGE;
					apply(false);
				}
			},
			{ rootMargin: '600px' },
		).observe(more);

		form.addEventListener('input', () => apply());
		form.addEventListener('reset', () => setTimeout(() => apply()));
		apply();
	}
</script>

<style>
	.top {
		padding-top: 24px;
	}
	.intro p {
		font-size: 1.0625rem;
		max-width: 52ch;
		margin: 0;
	}
	.library {
		padding-block: 32px var(--section-y);
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: flex-end;
		margin: 16px 0;
		padding: 16px 20px;
		background: #f8f8fa;
		border: 1px solid var(--border);
		border-radius: var(--radius-card);
	}
	.filters[hidden],
	[data-count][hidden],
	[data-empty][hidden],
	.more[hidden],
	tr[hidden] {
		display: none;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.field.search {
		flex: 1 1 240px;
	}
	label {
		font-size: 13px;
		font-weight: 600;
		color: var(--muted);
	}
	input,
	select {
		min-height: 44px;
		padding: 0 12px;
		font: inherit;
		color: var(--ink);
		background: #fff;
		border: 1px solid #b9b5c4;
		border-radius: 10px;
	}
	.clear {
		min-height: 44px;
		padding: 0 20px;
		font: inherit;
		font-weight: 600;
		color: var(--accent);
		background: none;
		border: 2px solid var(--accent);
		border-radius: var(--radius-pill);
		cursor: pointer;
	}
	.count {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th {
		text-align: left;
		padding: 10px 12px;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		border-bottom: 2px solid var(--ink);
	}
	td {
		padding: 14px 12px;
		vertical-align: top;
		border-bottom: 1px solid var(--border);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}
	.chip {
		padding: 1px 8px;
		font-size: 12px;
		line-height: 1.6;
		color: var(--accent);
		background: #f6eef4;
		border-radius: 999px;
		white-space: nowrap;
	}
	td.date {
		white-space: nowrap;
	}
	td.title {
		font-weight: 600;
		min-width: 18ch;
	}
	td.title a {
		color: var(--ink);
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
	}
	tbody tr:hover {
		background: #faf9fc;
	}
	.more {
		height: 1px;
	}
	.empty {
		padding: 24px 12px;
		color: var(--muted);
	}
	@media (max-width: 700px) {
		thead {
			display: none;
		}
		table,
		tbody,
		tr,
		td {
			display: block;
		}
		tr {
			padding: 12px 0;
			border-bottom: 1px solid var(--border);
		}
		td {
			display: flex;
			gap: 12px;
			padding: 2px 0;
			border: 0;
		}
		td::before {
			content: attr(data-label);
			flex: none;
			width: 72px;
			font-size: 12px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--muted);
		}
	}
</style>
