---
import { getPublished } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import PillButton from '../../components/PillButton.astro';
import { mailto, CONTACT_EMAIL } from '../../lib/site';
import { url } from '../../lib/url';

const all = await getPublished('resources');
const methods = all.filter((r) => r.data.kind === 'method');
const data = all.filter((r) => r.data.kind === 'data');
---

<BaseLayout
	title="Resources"
	description="Shared tools, protocols, and datasets from the CIN community."
>
	<PageHeader title="Resources" />

	<div class="container">
		<p class="construction" role="note">
			<svg
				viewBox="0 0 24 24"
				aria-hidden="true"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
				<circle cx="12" cy="12" r="3" />
			</svg>
			<span>
				<strong>Under construction.</strong> This page is still being built; the entries below are
				placeholders.
			</span>
		</p>
	</div>

	<section class="container res-section">
		<h2>Data</h2>
		<p class="intro">
			Public repositories of CIN-related data, including single-cell genomics and imaging.
		</p>
		<div class="table-wrap">
			<table>
				<caption class="visually-hidden">Data projects</caption>
				<thead>
					<tr>
						<th scope="col">Project Name</th>
						<th scope="col">Type</th>
						<th scope="col">Accession</th>
					</tr>
				</thead>
				<tbody>
					{data.map((r) => (
						<tr>
							<td data-label="Project" class="title">
								<a href={url(`resources/data/${r.id}/`)}>{r.data.title}</a>
							</td>
							<td data-label="Type">{r.data.category}</td>
							<td data-label="Accession">
								{r.data.accession_url ? (
									<a href={r.data.accession_url}>{r.data.accession}</a>
								) : (
									(r.data.accession ?? '—')
								)}
							</td>
						</tr>
					))}
				</tbody>
			</table>
			{!data.length && <p class="empty">No data projects yet.</p>}
		</div>
	</section>

	<section class="container res-section">
		<h2>Methods</h2>
		<p class="intro">
			Software, analysis pipelines, and protocols for detecting and measuring CIN.
		</p>
		<div class="table-wrap">
			<table>
				<caption class="visually-hidden">Methods</caption>
				<thead>
					<tr>
						<th scope="col">Method</th>
						<th scope="col">Type</th>
						<th scope="col">Links</th>
					</tr>
				</thead>
				<tbody>
					{methods.map((r) => (
						<tr>
							<td data-label="Method" class="title">
								{r.data.title}
							</td>
							<td data-label="Type">{r.data.category}</td>
							<td data-label="Links">
								<div class="icons">
									{r.data.repo && (
										<a
											href={r.data.repo}
											class="icon"
											title="Code repository"
											target="_blank"
											rel="noopener noreferrer"
										>
											<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
												<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
											</svg>
											<span class="visually-hidden">
												Code repository for {r.data.title} (opens in a new tab)
											</span>
										</a>
									)}
									{r.data.publication && (
										<a
											href={r.data.publication}
											class="icon"
											title="Publication"
											target="_blank"
											rel="noopener noreferrer"
										>
											<svg
												viewBox="0 0 24 24"
												aria-hidden="true"
												fill="none"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
												<path d="M14 3v5h5M9 13h6M9 17h6M9 9h2" />
											</svg>
											<span class="visually-hidden">
												Publication for {r.data.title} (opens in a new tab)
											</span>
										</a>
									)}
									{!r.data.repo && !r.data.publication && <span class="none">—</span>}
								</div>
							</td>
						</tr>
					))}
				</tbody>
			</table>
			{!methods.length && <p class="empty">No methods yet.</p>}
		</div>
	</section>

	<section class="container contribute">
		<Card variant="dark" class="feature-dark">
			<h3>Have a tool or dataset to share?</h3>
			<p>
				If you would like your tool or data listed here, email the details to{' '}
				<a href={mailto('iCIN - Add my resource to the iCIN website')}>{CONTACT_EMAIL}</a>.
			</p>
			<PillButton href={mailto('Add my resource')} variant="light">
				Email your details
			</PillButton>
		</Card>
	</section>
</BaseLayout>

<style>
	.construction {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 24px 0 0;
		padding: 12px 18px;
		background: #fff6e0;
		border: 1px solid #f0d58a;
		border-radius: var(--radius-card);
	}
	.construction svg {
		flex: none;
		width: 24px;
		height: 24px;
		color: #9a6700;
	}
	.intro {
		max-width: 62ch;
		color: var(--muted);
		margin-bottom: 24px;
	}
	.res-section {
		padding-top: 32px;
	}
	.res-section + .res-section {
		padding-top: 48px;
	}
	.contribute {
		padding-top: 48px;
		padding-bottom: var(--section-y);
	}
	.contribute :global(a:not(.pill)) {
		color: var(--pink);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th {
		text-align: left;
		padding: 10px 12px;
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		border-bottom: 2px solid var(--ink);
	}
	td {
		padding: 14px 12px;
		vertical-align: top;
		border-bottom: 1px solid var(--border);
	}
	td.title {
		font-weight: 600;
		min-width: 18ch;
	}
	td.title a {
		color: var(--ink);
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
	}
	tbody tr:hover {
		background: #faf9fc;
	}
	.icons {
		display: flex;
		gap: 14px;
	}
	.icon {
		display: inline-flex;
		color: var(--accent);
	}
	.icon:hover {
		color: var(--ink);
	}
	.icon svg {
		width: 24px;
		height: 24px;
	}
	.none,
	.empty {
		color: var(--muted);
	}
	@media (max-width: 700px) {
		thead {
			display: none;
		}
		table,
		tbody,
		tr,
		td {
			display: block;
		}
		tr {
			padding: 12px 0;
			border-bottom: 1px solid var(--border);
		}
		td {
			display: flex;
			gap: 12px;
			padding: 2px 0;
			border: 0;
		}
		td::before {
			content: attr(data-label);
			flex: none;
			width: 88px;
			font-size: 0.75rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--muted);
		}
	}
</style>
