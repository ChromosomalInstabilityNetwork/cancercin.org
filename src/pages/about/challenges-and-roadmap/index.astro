---
import SectionLayout from '../../../layouts/SectionLayout.astro';
import Card from '../../../components/Card.astro';
import { challengeGroups } from '../../../data/challenges';
import { roadmap } from '../../../data/roadmap';
import { url } from '../../../lib/url';
---

<SectionLayout
	title="Challenges & Roadmap"
	description="Three major challenges in chromosomal instability research, and a roadmap for addressing them."
>
	<section id="challenges" class="block">
		<h2>Three major challenges</h2>
		{challengeGroups.map((g) => (
			<div class="group">
				<div class="group-head">
					<span class="num" aria-hidden="true">
						{String(g.number).padStart(2, '0')}
					</span>
					<h3>{g.title}</h3>
				</div>
				<div class={`grid cols-${g.columns}`}>
					{g.items.map((c) => (
						<Card>
							<p class="label">Challenge {c.id}</p>
							<h4>{c.title}</h4>
							<p>{c.text}</p>
						</Card>
					))}
				</div>
			</div>
		))}
	</section>

	<section id="roadmap" class="block">
		<h2>A roadmap for future CIN research</h2>
		<div class="roadmap">
			{roadmap.map((r, i) => (
				<Card variant="dark" class="rm">
					<p class="rm-num" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</p>
					<h3>{r.title}</h3>
					<p>{r.text}</p>
					{r.action && (
						<p class="action">
							<a href={url(r.action.href)}>
								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="12" cy="12" r="3" />
									<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
								</svg>
								{r.action.label}
							</a>
						</p>
					)}
				</Card>
			))}
		</div>
	</section>
</SectionLayout>

<style>
	.group {
		margin-top: 48px;
	}
	.group-head {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-bottom: 24px;
	}
	.group-head h3 {
		margin: 0;
		font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
	}
	.num {
		font-family: var(--font-display);
		font-size: 1.75rem;
		line-height: 1;
		color: var(--accent);
	}
	.grid {
		display: grid;
		gap: 24px;
	}
	.cols-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.cols-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.label {
		margin: 0 0 8px;
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
	}
	.roadmap {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 24px;
		margin-top: 32px;
	}
	.roadmap :global(.rm) {
		grid-column: span 2;
	}
	.roadmap :global(.rm:nth-child(n + 4)) {
		grid-column: span 3;
	}
	.action {
		margin: 16px 0 0;
	}
	.action a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-weight: 600;
		color: var(--pink);
		text-decoration: none;
	}
	.action a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.action svg {
		flex: none;
		width: 18px;
		height: 18px;
	}
	.rm-num {
		font-family: var(--font-display);
		font-size: 1.75rem;
		line-height: 1;
		color: var(--pink);
		margin: 0 0 16px;
	}
	@media (max-width: 1100px) {
		.cols-3 {
			grid-template-columns: 1fr;
		}
		.roadmap {
			grid-template-columns: repeat(2, 1fr);
		}
		.roadmap :global(.rm),
		.roadmap :global(.rm:nth-child(n + 4)) {
			grid-column: auto;
		}
	}
	@media (max-width: 700px) {
		.cols-2,
		.roadmap {
			grid-template-columns: 1fr;
		}
	}
</style>
