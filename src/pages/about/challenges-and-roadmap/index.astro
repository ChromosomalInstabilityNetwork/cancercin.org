---
import SectionLayout from '../../../layouts/SectionLayout.astro';
import Card from '../../../components/Card.astro';
import { challengeGroups } from '../../../data/challenges';
import { roadmap } from '../../../data/roadmap';
---

<SectionLayout
	title="Challenges & Roadmap"
	description="Three major challenges in chromosomal instability research, and a roadmap for addressing them."
>
	<p slot="lead">
		Three major challenges stand between chromosomal instability research and patient benefit, and
		a shared roadmap for addressing them.
	</p>

	<section id="challenges" class="block">
		<h2>Three major challenges</h2>
		{
			challengeGroups.map((g) => (
				<div class="group">
					<div class="group-head">
						<span class="num" aria-hidden="true">
							{g.number}
						</span>
						<h3>{g.title}</h3>
					</div>
					<div class={`grid cols-${g.columns}`}>
						{g.items.map((c) => (
							<Card>
								<p class="label">Challenge {c.id}</p>
								<h4>{c.title}</h4>
								<p>{c.text}</p>
							</Card>
						))}
					</div>
				</div>
			))
		}
	</section>

	<section id="roadmap" class="block">
		<h2>A roadmap for future CIN research</h2>
		<div class="roadmap">
			{
				roadmap.map((r, i) => (
					<Card variant="dark" class="rm">
						<p class="rm-num" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</p>
						<h4>{r.title}</h4>
						<p>{r.text}</p>
					</Card>
				))
			}
		</div>
	</section>
</SectionLayout>

<style>
	h2 {
		font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
	}
	.group {
		margin-top: 48px;
	}
	.group-head {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-bottom: 24px;
	}
	.group-head h3 {
		margin: 0;
		font-size: clamp(1.4rem, 1.1rem + 0.9vw, 1.875rem);
	}
	.num {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
		line-height: 1;
		color: var(--accent);
	}
	.grid {
		display: grid;
		gap: 24px;
	}
	.cols-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.cols-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.label {
		margin: 0 0 8px;
		font-size: 13px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
	}
	.roadmap {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 24px;
		margin-top: 32px;
	}
	.roadmap :global(.rm) {
		grid-column: span 2;
	}
	.roadmap :global(.rm:nth-child(n + 4)) {
		grid-column: span 3;
	}
	.rm-num {
		font-family: var(--font-display);
		font-size: 2.5rem;
		line-height: 1;
		color: var(--pink);
		margin: 0 0 16px;
	}
	@media (max-width: 1100px) {
		.cols-3 {
			grid-template-columns: 1fr;
		}
		.roadmap {
			grid-template-columns: repeat(2, 1fr);
		}
		.roadmap :global(.rm),
		.roadmap :global(.rm:nth-child(n + 4)) {
			grid-column: auto;
		}
	}
	@media (max-width: 700px) {
		.cols-2,
		.roadmap {
			grid-template-columns: 1fr;
		}
	}
</style>
