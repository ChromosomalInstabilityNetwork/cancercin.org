---
import { getCollection, render } from 'astro:content';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import PersonAvatar from '../../../components/PersonAvatar.astro';
import SocialLinks from '../../../components/SocialLinks.astro';

const groups = (await getCollection('workingGroups')).sort(
	(a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const people = new Map((await getCollection('people')).map((p) => [p.id, p]));

const entries = await Promise.all(
	groups.map(async (g) => {
		const { Content } = await render(g);
		const members = g.data.members.map((id) => {
			const person = people.get(id);
			if (!person) throw new Error(`Working group "${g.id}" lists unknown person "${id}"`);
			return person;
		});
		return { group: g, Content, members };
	}),
);
---

<SectionLayout
	title="Working Groups"
	description="Teams across the International CIN Network collaborating on individual problems and challenges."
>
	<p class="intro">
		Teams across the network collaborating to tackle individual problems and challenges in CIN
		research.
	</p>

	{entries.map(({ group, Content, members }) => (
		<section class="block group" id={group.id} aria-labelledby={`h-${group.id}`}>
			<h2 id={`h-${group.id}`}>{group.data.title}</h2>
			<div class="desc">
				<Content />
			</div>
			<ul class="members" aria-label={`Members of the ${group.data.title}`}>
				{members.map((m) => {
					const link = m.data.website;
					return (
						<li class="member">
							<span class="face">
								<PersonAvatar name={m.data.name} photo={m.data.photo} />
							</span>
							<span class="info">
								<span class="who">
									{link ? (
										<a class="who-link" href={link} target="_blank" rel="noopener noreferrer">
											{m.data.name}
										</a>
									) : (
										m.data.name
									)}
								</span>
								{m.data.institution && <span class="inst">{m.data.institution}</span>}
								<span class="links">
									<SocialLinks
										name={m.data.name}
										website={m.data.website}
										bluesky={m.data.bluesky}
										x={m.data.x}
										linkedin={m.data.linkedin}
									/>
								</span>
							</span>
						</li>
					);
				})}
			</ul>
		</section>
	))}
</SectionLayout>

<style>
	.intro {
		max-width: 62ch;
		color: var(--muted);
		margin: 0 0 32px;
	}
	.desc {
		max-width: 62ch;
	}
	.members {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 20px 24px;
		margin: 24px 0 0;
		padding: 0;
	}
	.member {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 14px;
		color: var(--ink);
		text-align: left;
	}
	.face {
		flex: none;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		transition: transform 0.15s;
	}
	.info {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.who {
		font-family: var(--font-display);
		font-weight: 600;
		line-height: 1.25;
	}
	.who-link {
		color: inherit;
		text-decoration: none;
	}
	.who-link:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	/* The whole member (photo and text) is the click target for the website; icons stay above it. */
	.who-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.links {
		position: relative;
		z-index: 2;
		margin-left: -8px;
	}
	.inst {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: 0.8125rem;
		line-height: 1.35;
		color: var(--muted);
	}
</style>
