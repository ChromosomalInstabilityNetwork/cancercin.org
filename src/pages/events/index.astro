---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getEvents } from '../../lib/events';

const { upcoming, past } = await getEvents();
const CHANNEL_URL = 'https://www.youtube.com/@CINlectures';
---

<SectionLayout
	title="Events Calendar"
	description="Lectures, meeting sessions, and workshops for the CIN community."
>
	<a class="banner" href={CHANNEL_URL} target="_blank" rel="noopener noreferrer">
		<svg
			class="megaphone"
			viewBox="0 0 24 24"
			aria-hidden="true"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="m3 11 18-5v12L3 14v-3z" />
			<path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
		</svg>
		<span>
			Recordings from the International CIN lecture series are available on
			<span class="nowrap">
				<svg class="yt" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
					<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
				</svg>
				<strong>YouTube</strong>!
			</span>
			<span class="visually-hidden"> (opens in a new tab)</span>
		</span>
	</a>

	<section class="block">
		<h2>Upcoming events</h2>
		{upcoming.length ? (
			<div class="stack">
				{upcoming.map((e) => (
					<EventCard
						title={e.data.title}
						start={e.data.start}
						end={e.data.end}
						location={e.data.location}
						link={e.data.link}
						image={e.data.image}
						imageAlt={e.data.image_alt}
					>
						<p>{e.body}</p>
					</EventCard>
				))}
			</div>
		) : (
			<p>No upcoming events.</p>
		)}
	</section>

	<section class="block">
		<h2>Past events</h2>
		{past.length ? (
			<div class="stack">
				{past.map((e) => (
					<EventCard
						title={e.data.title}
						start={e.data.start}
						end={e.data.end}
						location={e.data.location}
						link={e.data.link}
						image={e.data.image}
						imageAlt={e.data.image_alt}
					>
						<p>{e.body}</p>
					</EventCard>
				))}
			</div>
		) : (
			<p>No past events yet.</p>
		)}
	</section>
</SectionLayout>

<style>
	.banner {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 32px;
		padding: 14px 20px;
		color: var(--ink);
		text-decoration: none;
		background: #f6eef4;
		border: 1px solid #e6cfe0;
		border-radius: var(--radius-card);
	}
	.banner:hover {
		border-color: var(--accent);
	}
	.banner:hover strong {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.nowrap {
		white-space: nowrap;
	}
	.megaphone {
		flex: none;
		width: 28px;
		height: 28px;
		color: var(--accent);
	}
	/* The YouTube mark sits inline with the text, just before the word "YouTube". */
	.yt {
		display: inline-block;
		width: 1.4em;
		height: 1.4em;
		margin: 0 0.15em 0 0.25em;
		vertical-align: -0.3em;
		color: #f00;
	}
	.stack {
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
	}
</style>
