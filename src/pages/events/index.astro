---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getEvents } from '../../lib/events';

const { upcoming, past } = await getEvents();
---

<SectionLayout
	title="Events Calendar"
	description="Lectures, meeting sessions, and workshops for the CIN community."
>

	<section class="block">
		<h2>Upcoming events</h2>
		<div class="stack">
			{
				upcoming.map((e) => (
					<EventCard
						title={e.data.title}
						start={e.data.start}
						end={e.data.end}
						location={e.data.location}
						link={e.data.link}
					>
						<p>{e.body}</p>
					</EventCard>
				))
			}
		</div>
	</section>

	<section class="block">
		<h2>Past events</h2>
		{
			past.length ? (
				<div class="stack">
					{past.map((e) => (
						<EventCard
							title={e.data.title}
							start={e.data.start}
							end={e.data.end}
							location={e.data.location}
							link={e.data.link}
						>
							<p>{e.body}</p>
						</EventCard>
					))}
				</div>
			) : (
				<p>No past events yet.</p>
			)
		}
	</section>
</SectionLayout>

<style>
	h2 {
		font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
	}
	.stack {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}
	@media (max-width: 1100px) {
		.stack {
			grid-template-columns: 1fr;
		}
	}
</style>
