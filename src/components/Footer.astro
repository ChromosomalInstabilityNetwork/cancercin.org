---
import { url } from '../lib/url';
import { SITE_NAME, SITE_DOMAIN, NAV, isGroup, type NavLink } from '../lib/site';

// One footer column per nav group; standalone nav links share a "Community" column.
const columns: { heading: string; links: NavLink[] }[] = [];
const community: NavLink[] = [];
for (const item of NAV) {
	if (isGroup(item)) columns.push({ heading: item.label, links: item.children });
	else community.push(item);
}
columns.push({ heading: 'Community', links: community });
---

<footer class="footer on-dark">
	<div class="container">
		<div class="top">
			<div class="brand">
				<p class="name">{SITE_NAME}</p>
				<p>A community of laboratories advancing chromosomal instability research from the bench to the clinic.</p>
			</div>
			<nav aria-label="Site map" class="map">
				{
					columns.map((col) => (
						<div>
							<h2>{col.heading}</h2>
							<ul>
								{col.links.map((l) => (
									<li>
										<a href={url(l.href)}>{l.label}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
		</div>
		<hr />
		<p class="legal">{SITE_NAME} · {SITE_DOMAIN}</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--ink);
		color: var(--on-dark);
		padding-block: clamp(40px, 6vw, 72px) 32px;
	}
	.top {
		display: grid;
		grid-template-columns: 1.2fr 2fr;
		gap: 40px;
	}
	.name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.5rem;
		color: var(--on-dark-strong);
		margin: 0 0 8px;
	}
	.brand p:last-child {
		max-width: 40ch;
		margin: 0;
	}
	.map {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
	h2 {
		margin: 0 0 8px;
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--pink);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--on-dark);
		text-decoration: none;
	}
	a:hover {
		color: var(--on-dark-strong);
		text-decoration: underline;
		text-decoration-color: var(--pink);
		text-underline-offset: 4px;
	}
	hr {
		border: 0;
		border-top: 1px solid var(--divider-dark);
		margin: 32px 0 20px;
	}
	.legal {
		margin: 0;
		font-size: 0.9375rem;
	}
	@media (max-width: 900px) {
		.top {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 520px) {
		.map {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
