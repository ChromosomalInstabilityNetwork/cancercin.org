---
import { url } from '../lib/url';
import { isCurrent, groupFor } from '../lib/nav';
import Logo from './Logo.astro';
import { NAV, isGroup } from '../lib/site';

const path = Astro.url.pathname;
const activeGroup = groupFor(path)?.label;
---

<header class="nav on-dark">
	<div class="container bar">
		<a class="brand" href={url('')}>
			<Logo />
		</a>
		<button
			class="toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-menu"
			data-nav-toggle
		>
			<span class="visually-hidden">Menu</span>
			<svg
				width="24"
				height="24"
				viewBox="0 0 24 24"
				aria-hidden="true"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
			>
				<path d="M3 6h18M3 12h18M3 18h18"></path>
			</svg>
		</button>
		<nav id="site-menu" aria-label="Main" data-nav-menu>
			<ul class="top">
				{NAV.map((item, i) =>
					isGroup(item) ? (
						<li class="has-menu" data-group>
							<button
								class="group-btn"
								type="button"
								aria-expanded="false"
								aria-controls={`menu-${i}`}
								data-current={activeGroup === item.label ? 'true' : undefined}
							>
								{item.label}
								<svg
									width="12"
									height="12"
									viewBox="0 0 12 12"
									aria-hidden="true"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M2 4l4 4 4-4" />
								</svg>
							</button>
							<span class="group-label">{item.label}</span>
							<ul class="menu" id={`menu-${i}`}>
								{item.children.map((c) => (
									<li>
										<a
											href={url(c.href)}
											aria-current={isCurrent(path, c.href) ? 'page' : undefined}
										>
											{c.label}
										</a>
									</li>
								))}
							</ul>
						</li>
					) : (
						<li>
							<a
								class="link"
								href={url(item.href)}
								aria-current={isCurrent(path, item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					),
				)}
			</ul>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));

	const setGroup = (g: HTMLElement, open: boolean) => {
		g.toggleAttribute('data-open', open);
		g.querySelector('.group-btn')?.setAttribute('aria-expanded', String(open));
	};
	const closeGroups = (except?: HTMLElement) =>
		groups.forEach((g) => g !== except && setGroup(g, false));

	groups.forEach((g) => {
		g.querySelector('.group-btn')?.addEventListener('click', () => {
			const open = !g.hasAttribute('data-open');
			closeGroups(g);
			setGroup(g, open);
		});
	});
	document.addEventListener('click', (e) => {
		if (!(e.target as HTMLElement).closest('[data-group]')) closeGroups();
	});

	if (toggle && menu) {
		const set = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			menu.toggleAttribute('data-open', open);
		};
		toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			const openGroup = groups.find((g) => g.hasAttribute('data-open'));
			if (openGroup) {
				closeGroups();
				openGroup.querySelector<HTMLElement>('.group-btn')?.focus();
			} else if (toggle.getAttribute('aria-expanded') === 'true') {
				set(false);
				toggle.focus();
			}
		});
		menu.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) set(false);
		});
	}
</script>

<style>
	.nav {
		background: var(--ink);
		color: var(--on-dark);
		position: sticky;
		top: 0;
		z-index: 50;
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 72px;
		position: relative;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		height: 56px;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.top {
		display: flex;
		gap: 8px;
	}
	.top > li {
		position: relative;
	}
	nav a,
	.group-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		padding: 0 12px;
		color: var(--on-dark);
		text-decoration: none;
		font: inherit;
		font-weight: 500;
		background: none;
		border: 0;
		cursor: pointer;
	}
	nav a:hover,
	.group-btn:hover {
		color: var(--on-dark-strong);
	}
	.link[aria-current='page'],
	.group-btn[data-current='true'] {
		color: var(--on-dark-strong);
		text-decoration: underline;
		text-decoration-color: var(--pink);
		text-decoration-thickness: 3px;
		text-underline-offset: 8px;
	}
	.group-btn svg {
		transition: transform 0.15s;
	}
	[data-open] > .group-btn svg {
		transform: rotate(180deg);
	}
	.group-label {
		display: none;
	}
	.menu {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 260px;
		padding: 8px;
		background: var(--ink);
		border: 1px solid var(--divider-dark);
		border-radius: var(--radius-card);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
	}
	[data-open] > .menu {
		display: block;
	}
	@media (hover: hover) and (min-width: 901px) {
		.has-menu:hover > .menu {
			display: block;
		}
	}
	.menu a {
		width: 100%;
		border-radius: 10px;
		padding: 0 14px;
	}
	.menu a:hover {
		background: var(--divider-dark);
	}
	.menu a[aria-current='page'] {
		color: var(--on-dark-strong);
		box-shadow: inset 3px 0 0 var(--pink);
	}
	.toggle {
		display: none;
		min-width: 44px;
		min-height: 44px;
		align-items: center;
		justify-content: center;
		background: none;
		border: 1px solid var(--divider-dark);
		border-radius: 12px;
		color: var(--on-dark-strong);
		cursor: pointer;
	}
	@media (max-width: 900px) {
		.toggle {
			display: inline-flex;
		}
		nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--ink);
			border-bottom: 1px solid var(--divider-dark);
			padding: 8px var(--pad-x) 16px;
		}
		nav[data-open] {
			display: block;
		}
		.top {
			flex-direction: column;
			gap: 0;
		}
		nav a {
			width: 100%;
			padding: 0;
		}
		/* Groups are shown expanded inside the mobile menu. */
		.group-btn {
			display: none;
		}
		.group-label {
			display: block;
			margin-top: 12px;
			font-size: 13px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--pink);
		}
		.menu {
			display: block;
			position: static;
			min-width: 0;
			padding: 0 0 0 12px;
			border: 0;
			box-shadow: none;
		}
		.menu a {
			padding: 0;
			border-radius: 0;
		}
		.menu a:hover {
			background: none;
		}
	}
</style>
