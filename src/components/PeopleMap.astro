---
import { url } from '../lib/url';
---

<a class="skip-map visually-hidden" href="#after-map">
	Skip map
</a>
<div
	class="map-wrap"
	id="people-map"
	role="region"
	aria-label="Map of network laboratories. The directory lists the same people."
	data-geojson={url('people.geojson')}
>
	<div class="map-canvas" data-map-canvas></div>
	<p class="map-status" data-map-status>
		<noscript>The interactive map needs JavaScript; use the directory.</noscript>
		<span data-map-loading>Loading map…</span>
	</p>
</div>
<div id="after-map" tabindex="-1"></div>

<script>
	// MapLibre locates its worker at runtime, which the bundler can't see; ship it as an asset.
	import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
	import { loadMapStyle } from '../lib/mapStyle';

	type Person = {
		id: string;
		name: string;
		institution: string;
		address: string;
		photo: string;
		coords: [number, number];
	};
	type Marker = {
		marker: any;
		root: HTMLElement;
		face: HTMLElement;
		line: SVGLineElement;
		dot: SVGCircleElement;
		dx: number;
		dy: number;
	};

	const wrap = document.getElementById('people-map')!;
	const canvas = wrap.querySelector<HTMLElement>('[data-map-canvas]')!;
	const status = wrap.querySelector<HTMLElement>('[data-map-status]')!;
	const scroller = document.querySelector<HTMLElement>('[data-scroll]');
	const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-person-id]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const FACE = 44; // px, diameter of a face
	const MIN_DIST = FACE + 4; // faces are never closer than this (centre to centre)
	const SELECT_ZOOM = 6;
	const SILHOUETTE =
		'<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="8.5" r="4"/><path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5z"/></svg>';
	const SVG_NS = 'http://www.w3.org/2000/svg';

	let selected: string | null = null;
	let map: any;
	let popup: any;
	let lib: typeof import('maplibre-gl');
	let filterIds: Set<string> | null = null;
	let hoverId: string | null = null;
	let leaders: SVGSVGElement; // one SVG under all markers, in map-pixel coordinates
	const people = new Map<string, Person>();
	const markers = new Map<string, Marker>();

	const avatar = (p: Person) => {
		const span = document.createElement('span');
		span.className = 'pm-av';
		if (p.photo) {
			const img = new Image();
			img.src = p.photo;
			img.alt = '';
			img.width = img.height = 96;
			span.append(img);
		} else {
			span.innerHTML = SILHOUETTE;
		}
		return span;
	};

	function toggle(id: string, scroll: boolean) {
		setSelected(selected === id ? null : id, { scroll });
	}

	/** One marker per person, anchored at their true position; the face may be pushed aside. */
	function makeMarker(p: Person): Marker {
		const root = document.createElement('div');
		root.className = 'pm-m'; // zero-sized, sits exactly on the person's location
		root.dataset.person = p.id;

		// Leader line + dot live in one shared layer under every face (see `leaders`), so no line can
		// ever be drawn on top of a person.
		const line = document.createElementNS(SVG_NS, 'line');
		const dot = document.createElementNS(SVG_NS, 'circle');
		dot.setAttribute('r', '3.5');
		leaders.append(line, dot);

		// Markers duplicate the directory, which is the accessible equivalent: keep them out of the tab order.
		const face = document.createElement('button');
		face.type = 'button';
		face.className = 'pm-pin';
		face.tabIndex = -1;
		face.setAttribute('aria-hidden', 'true');
		face.dataset.person = p.id;
		face.append(avatar(p));
		const label = document.createElement('span');
		label.className = 'pm-label';
		label.textContent = p.name;
		face.append(label);
		face.addEventListener('click', (e) => {
			e.stopPropagation();
			toggle(p.id, true);
		});

		root.append(face);
		const marker = new lib.Marker({ element: root }).setLngLat(p.coords).addTo(map);
		return { marker, root, face, line, dot, dx: 0, dy: 0 };
	}

	/**
	 * Push overlapping faces apart. Everyone starts on their true spot (projected to the screen); pairs
	 * closer than MIN_DIST are separated, with a gentle pull back toward the true spot so the shift stays
	 * small. A pure function of the positions, so the same view always gives the same result.
	 */
	function separate(pts: { x: number; y: number }[]) {
		const n = pts.length;
		const d = pts.map(() => ({ x: 0, y: 0 }));
		const GOLDEN = 2.399963;
		for (let iter = 0; iter < 90; iter++) {
			let moved = false;
			for (let i = 0; i < n; i++) {
				for (let j = i + 1; j < n; j++) {
					let dx = pts[i].x + d[i].x - (pts[j].x + d[j].x);
					let dy = pts[i].y + d[i].y - (pts[j].y + d[j].y);
					let dist = Math.hypot(dx, dy);
					if (dist >= MIN_DIST) continue;
					if (dist < 0.01) {
						// exactly the same spot: fan out in a deterministic direction
						const a = (i * 31 + j) * GOLDEN;
						dx = Math.cos(a);
						dy = Math.sin(a);
						dist = 1;
					}
					const push = (MIN_DIST - dist) / 2;
					const ux = dx / dist;
					const uy = dy / dist;
					d[i].x += ux * push;
					d[i].y += uy * push;
					d[j].x -= ux * push;
					d[j].y -= uy * push;
					moved = true;
				}
			}
			if (!moved) break;
			if (iter < 60) {
				// the pull back toward the true spot only runs in the early passes, then it settles
				for (const o of d) {
					o.x *= 0.97;
					o.y *= 0.97;
				}
			}
		}
		return d;
	}

	let frame = 0;
	function scheduleLayout() {
		if (!frame) frame = requestAnimationFrame(layout);
	}

	function layout() {
		frame = 0;
		if (!map) return;
		const shown: { id: string; m: Marker; x: number; y: number }[] = [];
		for (const [id, m] of markers) {
			const on = !filterIds || filterIds.has(id);
			m.root.hidden = !on;
			m.line.style.display = on ? '' : 'none';
			m.dot.style.display = on ? '' : 'none';
			if (!on) continue;
			const pt = map.project(people.get(id)!.coords);
			shown.push({ id, m, x: pt.x, y: pt.y });
		}
		const offsets = separate(shown);
		shown.forEach(({ id, m }, i) => {
			const { x, y } = offsets[i];
			m.dx = x;
			m.dy = y;
			m.face.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
			// A leader line from the true spot to a face that has been moved away from it.
			const moved = Math.hypot(x, y) > 3;
			const px = shown[i].x;
			const py = shown[i].y;
			m.line.setAttribute('x1', px.toFixed(1));
			m.line.setAttribute('y1', py.toFixed(1));
			m.line.setAttribute('x2', (px + x).toFixed(1));
			m.line.setAttribute('y2', (py + y).toFixed(1));
			m.dot.setAttribute('cx', px.toFixed(1));
			m.dot.setAttribute('cy', py.toFixed(1));
			m.line.style.display = moved ? '' : 'none';
			m.dot.style.display = moved ? '' : 'none';
			m.root.classList.toggle('pm-moved', moved);
			if (id === selected) positionPopup(m);
		});
	}

	function positionPopup(m: Marker) {
		popup?.setOffset([m.dx, m.dy - FACE / 2 - 8]);
	}

	function markState() {
		for (const [id, m] of markers) {
			m.root.classList.toggle('pm-selected', id === selected);
			m.face.classList.toggle('is-selected', id === selected);
			m.root.classList.toggle('pm-hovered', id === hoverId);
		}
	}

	function setSelected(id: string | null, opts: { scroll?: boolean } = {}) {
		popup?.remove();
		selected = id;
		for (const c of cards) c.setAttribute('aria-pressed', String(c.dataset.personId === id));
		markState();
		if (!id) return;

		const card = cards.find((c) => c.dataset.personId === id);
		if (opts.scroll && card && scroller) {
			const l = scroller.getBoundingClientRect();
			const r = card.getBoundingClientRect();
			if (r.top < l.top || r.bottom > l.bottom) {
				card.scrollIntoView({
					block: 'nearest',
					behavior: reduceMotion.matches ? 'auto' : 'smooth',
				});
			}
		}

		const p = people.get(id);
		if (!map || !p) return;
		const target = { center: p.coords, zoom: Math.max(map.getZoom(), SELECT_ZOOM) };
		if (reduceMotion.matches) map.jumpTo(target);
		else map.flyTo({ ...target, speed: 0.8, essential: false });

		const el = document.createElement('div');
		el.className = 'pm-pop';
		const name = document.createElement('strong');
		name.textContent = p.name;
		el.append(name);
		for (const [text, cls] of [
			[p.institution, ''],
			[p.address, 'pm-pop-addr'],
		]) {
			if (!text) continue;
			const d = document.createElement('div');
			d.textContent = text;
			if (cls) d.className = cls;
			el.append(d);
		}
		// Reuse the directory's link icons so the callout always matches the list.
		const links = document.querySelector(`#${CSS.escape(id)} .links .social`);
		if (links) el.append(links.cloneNode(true));
		popup = new lib.Popup({ offset: 0, maxWidth: '280px', closeButton: false })
			.setLngLat(p.coords)
			.setDOMContent(el)
			.addTo(map);
		const m = markers.get(id);
		if (m) positionPopup(m);
	}

	function setHover(id: string | null) {
		hoverId = id;
		markState();
	}

	for (const c of cards) {
		const id = c.dataset.personId!;
		c.addEventListener('click', () => toggle(id, false));
		const row = c.closest('li') ?? c;
		row.addEventListener('pointerenter', () => setHover(id));
		row.addEventListener('pointerleave', () => setHover(null));
		c.addEventListener('focus', () => setHover(id));
		c.addEventListener('blur', () => setHover(null));
	}
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && selected) setSelected(null);
	});

	// Directory search: only the matching people stay on the map, and the rest re-pack around them.
	window.addEventListener('people:filter', (e) => {
		const ids = (e as CustomEvent<{ ids: string[] | null }>).detail.ids;
		filterIds = ids ? new Set(ids) : null;
		if (selected && filterIds && !filterIds.has(selected)) setSelected(null);
		scheduleLayout();
	});
	// The map was shown again after being hidden.
	window.addEventListener('people:mapshown', () => {
		map?.resize();
		scheduleLayout();
	});

	async function init() {
		try {
			const [maplibre, style, data] = await Promise.all([
				import('maplibre-gl'),
				loadMapStyle(),
				fetch(wrap.dataset.geojson!).then((r) => r.json()),
				import('maplibre-gl/dist/maplibre-gl.css'),
			]);
			lib = maplibre;
			lib.setWorkerUrl(new URL(workerUrl, location.href).href);
			for (const f of data.features) {
				const pr = f.properties;
				people.set(pr.id, { ...pr, coords: f.geometry.coordinates });
			}

			map = new lib.Map({
				container: canvas,
				style,
				center: [10, 25],
				zoom: 1,
				maxZoom: 9,
				minZoom: 0,
				pitchWithRotate: false,
				dragRotate: false,
				scrollZoom: false, // page scrolling must not zoom the map; use the +/- buttons
				attributionControl: { compact: false },
			});
			map.touchZoomRotate.disableRotation();
			map.addControl(new lib.NavigationControl({ showCompass: false }), 'top-right');

			const timer = window.setTimeout(() => {
				status.hidden = false;
				status.textContent = 'The map is taking too long to load. Use the directory instead.';
			}, 20000);

			map.on('load', () => {
				window.clearTimeout(timer);
				status.hidden = true;
				map.resize();
				if (people.size) {
					const b = new lib.LngLatBounds();
					for (const p of people.values()) b.extend(p.coords);
					map.fitBounds(b, { padding: 70, maxZoom: 4, animate: false });
				}
				// Added before any marker, so it sits beneath all of them.
				leaders = document.createElementNS(SVG_NS, 'svg');
				leaders.setAttribute('class', 'pm-leaders');
				leaders.setAttribute('aria-hidden', 'true');
				map.getCanvasContainer().append(leaders);
				for (const p of people.values()) markers.set(p.id, makeMarker(p));
				map.on('move', scheduleLayout);
				map.on('resize', scheduleLayout);
				layout();
				markState();
				if (selected) setSelected(selected);
			});
			map.on('error', (e: any) => console.warn('Map error', e?.error ?? e));
		} catch (err) {
			console.warn(err);
			status.hidden = false;
			status.textContent = 'The map could not be loaded. Use the directory instead.';
		}
	}

	// Deep link from the home page community preview: /people/#person-id
	const hashId = decodeURIComponent(location.hash.slice(1));
	if (cards.some((c) => c.dataset.personId === hashId)) setSelected(hashId, { scroll: true });

	// Lazy-load the map once it nears the viewport.
	if ('IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					io.disconnect();
					init();
				}
			},
			{ rootMargin: '300px' },
		);
		io.observe(wrap);
	} else {
		init();
	}
</script>

<style>
	.map-wrap {
		position: relative;
		height: 100%;
		min-height: 0;
		overflow: hidden;
		background: var(--map-land);
	}
	.map-canvas {
		position: absolute;
		inset: 0;
	}
	.map-status[hidden] {
		display: none;
	}
	.map-status {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		margin: 0;
		padding: 24px;
		text-align: center;
		color: var(--muted);
		pointer-events: none;
	}
	.skip-map:focus {
		position: static;
		width: auto;
		height: auto;
		margin: 0 0 8px;
		clip: auto;
		display: inline-block;
		padding: 8px 16px;
		background: var(--pink);
		color: var(--ink);
		border-radius: var(--radius-pill);
		font-weight: 600;
	}

	/* Faces on the map (created by script, so these rules are global). */
	:global(.pm-m) {
		width: 0;
		height: 0;
	}
	:global(.pm-m[hidden]) {
		display: none;
	}
	:global(.pm-av) {
		display: grid;
		place-items: end center;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: 50%;
		background: #e8e6ee;
		color: #aaa7bd;
	}
	:global(.pm-av img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	:global(.pm-av svg) {
		width: 80%;
		height: 80%;
	}
	/* Thin lines and dots from pushed-aside faces back to their true locations: one layer that sits
	   beneath every face. */
	:global(.pm-leaders) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}
	:global(.pm-leaders line) {
		stroke: rgba(27, 26, 46, 0.45);
		stroke-width: 1.5;
	}
	:global(.pm-leaders circle) {
		fill: var(--accent);
		stroke: #fff;
		stroke-width: 1.5;
	}
	:global(.pm-pin) {
		position: absolute;
		left: -22px;
		top: -22px;
		width: 44px;
		height: 44px;
		padding: 0;
		font: inherit;
		cursor: pointer;
		background: #fff;
		border: 3px solid #fff;
		border-radius: 50%;
		box-shadow: 0 1px 4px rgba(27, 26, 46, 0.4);
		transition: border-color 0.15s;
	}
	:global(.pm-pin:hover) {
		border-color: var(--pink);
	}
	:global(.pm-pin.is-selected) {
		border-color: var(--accent);
	}
	:global(.pm-m.pm-moved) {
		z-index: 1;
	}
	:global(.pm-hovered),
	:global(.pm-selected) {
		z-index: 6;
	}
	:global(.pm-hovered .pm-pin) {
		border-color: var(--accent);
		box-shadow:
			0 0 0 3px rgba(138, 47, 115, 0.35),
			0 2px 8px rgba(27, 26, 46, 0.5);
	}
	:global(.pm-label) {
		position: absolute;
		top: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%);
		display: none;
		padding: 3px 10px;
		white-space: nowrap;
		font-size: 13px;
		font-weight: 600;
		color: #fff;
		background: var(--ink);
		border-radius: 999px;
		pointer-events: none;
	}
	:global(.pm-hovered .pm-label) {
		display: block;
	}

	:global(.maplibregl-popup-content) {
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--ink);
		border-radius: 12px;
		padding: 12px 16px;
	}
	:global(.pm-pop) {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	:global(.pm-pop-addr) {
		color: var(--muted);
		font-size: 13px;
	}
	:global(.pm-pop .social) {
		display: flex;
		gap: 2px;
		margin: 6px 0 -6px -8px;
		padding: 0;
		list-style: none;
	}
	:global(.pm-pop .social a) {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		color: var(--muted);
	}
	:global(.pm-pop .social a:hover) {
		color: var(--accent);
		background: #f1eff6;
	}
	:global(.pm-pop .social svg) {
		width: 16px;
		height: 16px;
	}
	:global(.maplibregl-ctrl-attrib) {
		font-size: 12px;
	}
</style>
