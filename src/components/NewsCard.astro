---
import Card from './Card.astro';

interface Props {
	title: string;
	date: Date;
	summary: string;
	link?: string;
}
const { title, date, summary, link } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<Card>
	<p class="date"><time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time></p>
	<h3>{link ? <a href={link}>{title}</a> : title}</h3>
	<p>{summary}</p>
</Card>

<style>
	.date {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	h3 a {
		color: inherit;
		text-decoration-color: var(--pink);
		text-underline-offset: 4px;
	}
</style>
