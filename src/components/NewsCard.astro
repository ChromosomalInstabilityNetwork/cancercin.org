---
import Card from './Card.astro';

interface Props {
	title: string;
	date?: Date;
	summary: string;
	link?: string;
}
const { title, date, summary, link } = Astro.props;
const label = date
	? new Intl.DateTimeFormat('en-US', {
			month: 'long',
			day: 'numeric',
			year: 'numeric',
			timeZone: 'UTC',
		}).format(date)
	: '[Date]';
---

<Card>
	<p class="date">
		{date ? <time datetime={date.toISOString().slice(0, 10)}>{label}</time> : label}
	</p>
	<h3>{link ? <a href={link}>{title}</a> : title}</h3>
	<p>{summary}</p>
</Card>

<style>
	.date {
		margin: 0 0 8px;
		color: var(--accent);
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	h3 a {
		color: inherit;
		text-decoration-color: var(--pink);
		text-underline-offset: 4px;
	}
</style>
