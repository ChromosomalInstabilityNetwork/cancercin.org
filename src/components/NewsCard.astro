---
import Card from './Card.astro';
import { url } from '../lib/url';
import { formatPostDate } from '../lib/events';

interface Props {
	title: string;
	date?: Date;
	summary: string;
	link?: string;
	image?: string;
	imageAlt?: string;
	headingLevel?: 'h2' | 'h3';
	/** Image on top of the text instead of beside it (for grids of cards). */
	stacked?: boolean;
}
const {
	title,
	date,
	summary,
	link,
	image,
	imageAlt = '',
	headingLevel: H = 'h3',
	stacked = false,
} = Astro.props;
const label = formatPostDate(date);
---

<Card>
	<div class:list={['row', { stacked }]}>
		<div class="body">
			<p class="date">
				{date ? <time datetime={date.toISOString().slice(0, 10)}>{label}</time> : label}
			</p>
			<H class="title">{link ? <a href={link}>{title}</a> : title}</H>
			<p>{summary}</p>
		</div>
		{image && (
			<img
				class="thumb"
				src={url(image)}
				alt={imageAlt}
				width={stacked ? 640 : 96}
				height={stacked ? 360 : 96}
				loading="lazy"
			/>
		)}
	</div>
</Card>

<style>
	.row {
		display: flex;
		gap: 20px;
		align-items: flex-start;
	}
	.body {
		min-width: 0;
		flex: 1;
	}
	.body > :global(p:last-child) {
		margin-bottom: 0;
	}
	.stacked {
		flex-direction: column;
		gap: 16px;
	}
	.stacked .thumb {
		order: -1;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
	}
	.thumb {
		flex: none;
		width: 96px;
		height: 96px;
		object-fit: cover;
		border-radius: 12px;
		background: var(--border);
	}
	@media (max-width: 520px) {
		.thumb {
			width: 64px;
			height: 64px;
		}
	}
	.date {
		margin: 0 0 8px;
		color: var(--accent);
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.title {
		font-size: var(--fs-card-title);
		line-height: 1.2;
	}
	.title a {
		color: inherit;
		text-decoration-color: var(--pink);
		text-underline-offset: 4px;
	}
</style>
