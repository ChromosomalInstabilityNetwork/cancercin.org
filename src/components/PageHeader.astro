---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<header class="page-header">
	<div class="container">
		<h1>{title}</h1>
	</div>
</header>

<style>
	.page-header {
		padding-top: clamp(32px, 5vw, 56px);
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
		max-width: 880px;
	}
</style>
