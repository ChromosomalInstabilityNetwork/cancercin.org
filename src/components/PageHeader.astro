---
import Eyebrow from './Eyebrow.astro';

interface Props {
	eyebrow?: string;
	title: string;
}
const { eyebrow, title } = Astro.props;
---

<header class="page-header on-dark">
	<div class="container">
		{eyebrow && <Eyebrow onDark>{eyebrow}</Eyebrow>}
		<h1>{title}</h1>
		<div class="lede"><slot /></div>
	</div>
</header>

<style>
	.page-header {
		background: var(--ink);
		color: var(--on-dark);
		padding-block: clamp(40px, 7vw, 88px);
	}
	h1 {
		color: var(--on-dark-strong);
		margin-bottom: 0.3em;
		max-width: 20ch;
	}
	.lede {
		max-width: 60ch;
		font-size: 1.1875rem;
	}
	.lede :global(:last-child) {
		margin-bottom: 0;
	}
</style>
