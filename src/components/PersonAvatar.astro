---
import { url } from '../lib/url';

interface Props {
	name: string;
	photo?: string;
	class?: string;
}
const { name, photo, class: className } = Astro.props;
---

{photo ? (
	<img
		class:list={['avatar', className]}
		src={url(photo)}
		alt=""
		width="96"
		height="96"
		loading="lazy"
		data-name={name}
	/>
) : (
	<span class:list={['avatar', 'placeholder', className]} aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="currentColor">
			<circle cx="12" cy="8.5" r="4"></circle>
			<path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5z"></path>
		</svg>
	</span>
)}

<style>
	.avatar {
		display: block;
		flex: none;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}
	.placeholder {
		display: grid;
		place-items: end center;
		overflow: hidden;
		background: #e8e6ee;
		color: #aaa7bd;
	}
	.placeholder svg {
		width: 80%;
		height: 80%;
	}
</style>
