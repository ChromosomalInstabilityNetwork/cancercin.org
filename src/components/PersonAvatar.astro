---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Headshots live in src/img/people; `photo` is the filename (e.g. jane-doe.png).
const photos = import.meta.glob<{ default: ImageMetadata }>('../img/people/*.{png,jpg,jpeg,webp}', {
	eager: true,
});

interface Props {
	name: string;
	photo?: string; // filename in src/img/people
	class?: string;
}
const { name, photo, class: className } = Astro.props;
const src = photo ? photos[`../img/people/${photo}`]?.default : undefined;
---

{src ? (
	<Image
		class:list={['avatar', className]}
		src={src}
		alt=""
		width={192}
		height={192}
		loading="lazy"
		data-name={name}
	/>
) : (
	<span class:list={['avatar', 'placeholder', className]} aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="currentColor">
			<circle cx="12" cy="8.5" r="4"></circle>
			<path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5z"></path>
		</svg>
	</span>
)}

<style>
	.avatar {
		display: block;
		flex: none;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}
	.placeholder {
		display: grid;
		place-items: end center;
		overflow: hidden;
		background: #e8e6ee;
		color: #aaa7bd;
	}
	.placeholder svg {
		width: 80%;
		height: 80%;
	}
</style>
