---
import { url } from '../lib/url';
---

<!--
	Cookie consent. Nothing that measures visitors (Cloudflare Web Analytics) is loaded until the
	visitor opts in. The choice is kept in localStorage for 12 months.
	The footer's "Cookie settings" button (data-consent-open) reopens the settings at any time.
-->
<section class="consent" id="consent-banner" aria-labelledby="consent-title" hidden>
	<div class="consent-text">
		<h2 id="consent-title">Your privacy</h2>
		<p>
			We would like to use analytics to understand how this site is used. It is off unless you
			accept. See our <a href={url('privacy/')}>privacy page</a> for details.
		</p>
	</div>
	<div class="consent-actions">
		<button type="button" class="btn" data-consent="reject">
			Reject all
		</button>
		<button type="button" class="btn" data-consent="accept">
			Accept all
		</button>
		<button type="button" class="btn ghost" data-consent-open>
			Customize
		</button>
	</div>
</section>

<dialog class="consent-dialog" id="consent-dialog" aria-labelledby="consent-dialog-title">
	<form method="dialog" id="consent-form">
		<h2 id="consent-dialog-title">Cookie settings</h2>
		<p>
			Choose what this site may use. You can change this at any time from "Cookie settings" in the
			footer.
		</p>
		<div class="row">
			<div>
				<strong>Strictly necessary</strong>
				<p>Stores your choice on this page on your device. It sets no cookies and is not shared.</p>
			</div>
			<span class="always">Always on</span>
		</div>
		<div class="row">
			<div>
				<label for="consent-analytics">
					<strong>Analytics</strong>
				</label>
				<p id="consent-analytics-desc">
					Cloudflare Web Analytics, which tells us which pages are visited and how visitors reach
					the site. It does not use cookies.
				</p>
			</div>
			<input type="checkbox" id="consent-analytics" aria-describedby="consent-analytics-desc" />
		</div>
		<div class="consent-actions">
			<button type="button" class="btn" data-consent="reject">
				Reject all
			</button>
			<button type="button" class="btn" data-consent="accept">
				Accept all
			</button>
			<button type="button" class="btn primary" data-consent="save">
				Save choices
			</button>
		</div>
	</form>
</dialog>

<script is:inline>
	(() => {
		const KEY = 'icin-consent';
		const CF_TOKEN = '8a04ad26ca2840d4be864aa9484907ab';
		const MAX_AGE = 365 * 24 * 60 * 60 * 1000;
		let loaded = false;

		const read = () => {
			try {
				const c = JSON.parse(localStorage.getItem(KEY));
				if (c && c.v === 1 && Date.now() - c.ts < MAX_AGE) return c;
			} catch {
				// storage unavailable: treat as no choice yet
			}
			return null;
		};
		const write = (analytics) => {
			try {
				localStorage.setItem(KEY, JSON.stringify({ v: 1, analytics, ts: Date.now() }));
			} catch {
				// storage unavailable: the banner will simply ask again
			}
		};

		const loadAnalytics = () => {
			if (loaded) return;
			loaded = true;
			const cf = document.createElement('script');
			cf.type = 'module';
			cf.src = 'https://static.cloudflareinsights.com/beacon.min.js';
			cf.setAttribute('data-cf-beacon', JSON.stringify({ token: CF_TOKEN }));
			document.body.appendChild(cf);
		};

		const banner = document.getElementById('consent-banner');
		const dialog = document.getElementById('consent-dialog');
		const box = document.getElementById('consent-analytics');
		let opener = null;

		const apply = (analytics) => {
			write(analytics);
			banner.hidden = true;
			if (dialog.open) dialog.close();
			if (analytics) loadAnalytics();
			else if (loaded) {
				// A script that is already running can't be unloaded: reload the page without it.
				location.reload();
				return;
			}
			if (opener && opener.isConnected) opener.focus();
			opener = null;
		};

		const openSettings = (trigger) => {
			const c = read();
			box.checked = !!(c && c.analytics);
			opener = trigger;
			dialog.showModal();
		};

		document.addEventListener('click', (e) => {
			const t = e.target.closest ? e.target.closest('[data-consent], [data-consent-open]') : null;
			if (!t) return;
			const action = t.getAttribute('data-consent');
			if (action === 'accept') apply(true);
			else if (action === 'reject') apply(false);
			else if (action === 'save') apply(box.checked);
			else openSettings(t);
		});

		const current = read();
		if (!current) banner.hidden = false;
		else if (current.analytics) loadAnalytics();
	})();
</script>

<style>
	.consent {
		position: fixed;
		inset: auto 0 0 0;
		z-index: 1000;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 32px;
		padding: 20px var(--gutter, 20px);
		color: var(--on-dark);
		background: var(--ink);
		border-top: 3px solid var(--pink);
		box-shadow: 0 -8px 24px rgb(0 0 0 / 0.25);
	}
	.consent[hidden] {
		display: none;
	}
	.consent-text {
		flex: 1 1 360px;
		max-width: 70ch;
	}
	h2 {
		margin: 0 0 4px;
		font-family: var(--font-body);
		font-size: 1.0625rem;
	}
	.consent h2 {
		color: var(--on-dark-strong);
	}
	p {
		margin: 0;
		font-size: 0.9375rem;
	}
	.consent a {
		color: var(--on-dark-strong);
		text-decoration-color: var(--pink);
		text-underline-offset: 3px;
	}
	.consent-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.btn {
		min-height: 44px;
		padding: 10px 22px;
		font: inherit;
		font-weight: 600;
		color: var(--ink);
		background: #fff;
		border: 2px solid #fff;
		border-radius: var(--radius-pill);
		cursor: pointer;
	}
	.btn:hover {
		background: var(--pink);
		border-color: var(--pink);
	}
	.btn.ghost {
		color: var(--on-dark-strong);
		background: transparent;
		border-color: var(--on-dark);
	}
	.btn.ghost:hover {
		background: rgb(255 255 255 / 0.12);
	}
	.btn:focus-visible {
		outline: 3px solid var(--pink);
		outline-offset: 3px;
	}
	/* In the white dialog the buttons need dark-on-light colours. */
	.consent-dialog .btn {
		color: var(--accent);
		background: transparent;
		border-color: var(--accent);
	}
	.consent-dialog .btn:hover {
		background: #f6eef4;
	}
	.consent-dialog .btn.primary {
		color: #fff;
		background: var(--accent);
	}
	.consent-dialog .btn.primary:hover {
		background: var(--ink);
		border-color: var(--ink);
	}
	.consent-dialog .btn:focus-visible {
		outline-color: var(--accent);
	}
	.consent-dialog {
		width: min(560px, calc(100% - 32px));
		padding: 28px;
		color: var(--ink);
		background: #fff;
		border: 0;
		border-radius: var(--radius-card);
	}
	.consent-dialog::backdrop {
		background: rgb(27 26 46 / 0.6);
	}
	.consent-dialog h2 {
		font-size: 1.25rem;
	}
	.consent-dialog p {
		color: var(--muted);
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 20px;
		padding: 16px 0;
		border-bottom: 1px solid var(--border);
	}
	.row p {
		margin-top: 2px;
	}
	.always {
		flex: none;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--muted);
	}
	input[type='checkbox'] {
		flex: none;
		width: 24px;
		height: 24px;
		margin: 0;
		accent-color: var(--accent);
	}
	.consent-dialog .consent-actions {
		margin-top: 20px;
	}
</style>
