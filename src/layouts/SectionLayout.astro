---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
import { groupFor, isCurrent } from '../lib/nav';

interface Props {
	title: string;
	/** Page <title>; defaults to `title`. */
	pageTitle?: string;
	description?: string;
}
const { title, pageTitle, description } = Astro.props;
const path = Astro.url.pathname;
const group = groupFor(path);
---

<BaseLayout title={pageTitle ?? title} description={description}>
	<PageHeader title={title} />

	<div class="container layout">
		{group && (
			<nav class="side" aria-label={`${group.label} pages`}>
				<p class="side-title">{group.label}</p>
				<ul>
					{group.children.map((c) => (
						<li>
							<a href={url(c.href)} aria-current={isCurrent(path, c.href) ? 'page' : undefined}>
								{c.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)}
		<div class="content">
			<slot />
		</div>
	</div>
</BaseLayout>

<style>
	.layout {
		display: grid;
		grid-template-columns: 20% minmax(0, 1fr);
		gap: 48px;
		padding-block: clamp(24px, 4vw, 40px) var(--section-y);
	}
	.side {
		align-self: start;
		position: sticky;
		top: 96px;
	}
	.side-title {
		margin: 0 0 12px;
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 2px solid var(--border);
	}
	a {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 4px 0 4px 16px;
		margin-left: -2px;
		border-left: 2px solid transparent;
		color: var(--muted);
		text-decoration: none;
		font-weight: 500;
		line-height: 1.3;
	}
	a:hover {
		color: var(--ink);
	}
	a[aria-current='page'] {
		color: var(--accent);
		border-left-color: var(--accent);
		font-weight: 600;
	}
	.content :global(.block + .block) {
		margin-top: clamp(40px, 6vw, 72px);
	}
	@media (max-width: 900px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 24px;
		}
		.side {
			display: none;
		}
	}
</style>
