---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { url } from '../lib/url';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}
const { title, description = SITE_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.png'), Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- minimum-scale=1 stops iOS Safari from zooming the page out to fit anything wider than the screen -->
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, minimum-scale=1, shrink-to-fit=no"
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<link rel="icon" href={url('favicon.ico')} sizes="any" />
		<link rel="canonical" href={canonical} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={SITE_NAME} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="theme-color" content="#1b1a2e" />
		<link rel="sitemap" href={url('sitemap-index.xml')} />
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<Nav />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script is:inline>
			// Add ?debug to any URL to show how wide the browser thinks the page is (for diagnosing devices).
			if (location.search.includes('debug')) {
				addEventListener('load', function () {
					const wide = [].slice
						.call(document.querySelectorAll('body *'))
						.map(function (e) {
							return [e, e.getBoundingClientRect().right];
						})
						.sort(function (a, b) {
							return b[1] - a[1];
						})
						.slice(0, 3)
						.map(function (x) {
							return (
								x[0].tagName.toLowerCase() +
								'.' +
								String(
									x[0].className && x[0].className.baseVal !== undefined
										? x[0].className.baseVal
										: x[0].className,
								).slice(0, 24) +
								' right=' +
								Math.round(x[1])
							);
						});
					const vv = window.visualViewport;
					const box = document.createElement('pre');
					box.style.cssText =
						'position:fixed;left:0;bottom:0;right:0;z-index:99999;margin:0;padding:8px;background:#000;color:#0f0;font:12px/1.3 monospace;white-space:pre-wrap';
					box.textContent = [
						'innerWidth ' + innerWidth + '  clientWidth ' + document.documentElement.clientWidth,
						'scrollWidth ' +
							document.documentElement.scrollWidth +
							'  body ' +
							document.body.scrollWidth,
						'visualViewport ' + (vv ? vv.width + ' scale ' + vv.scale : 'n/a'),
						'max-width:900px matches: ' + matchMedia('(max-width: 900px)').matches,
						'DPR ' + devicePixelRatio + '  screen ' + screen.width + 'x' + screen.height,
						'widest: ' + wide.join(' | '),
						'UA ' + navigator.userAgent,
					].join('\n');
					document.body.appendChild(box);
				});
			}
		</script>
		<ConsentBanner />
	</body>
</html>
